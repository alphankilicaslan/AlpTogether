<Window x:Class="AlpTogether.Controls.CarsTheaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arabalar 1 (Cars 2006) — Tam Ekran Sinema Modu"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#050209"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        Icon="pack://application:,,,/AlpTogether;component/Assets/app_icon.ico">

    <Grid Background="#050209" x:Name="RootFullscreenGrid">
        <!-- Main Fullscreen Video Viewport -->
        <MediaElement x:Name="TheaterMedia"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Close"
                      ScrubbingEnabled="True"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderOptions.BitmapScalingMode="Linear"
                      RenderOptions.EdgeMode="Aliased"
                      MediaOpened="TheaterMedia_MediaOpened"
                      MediaEnded="TheaterMedia_MediaEnded"
                      MediaFailed="TheaterMedia_MediaFailed"
                      MouseLeftButtonDown="TheaterMedia_MouseLeftButtonDown" />

        <!-- Center Play/Pause Indicator (Flashing on toggle) -->
        <Border x:Name="CenterActionIndicator"
                Width="84" Height="84"
                CornerRadius="42"
                Background="#99150824"
                BorderBrush="#FF2E93"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#FF2E93" BlurRadius="24" ShadowDepth="0" Opacity="0.8" />
            </Border.Effect>
            <TextBlock x:Name="TxtCenterActionIcon"
                       Text="▶"
                       Foreground="#FFFFFF"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0" />
        </Border>

        <!-- Top Holographic Title & Header Bar (Auto-hiding) -->
        <Border x:Name="TopHeaderBar"
                VerticalAlignment="Top"
                Background="#B3090412"
                BorderBrush="#3D184E"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Border.Effect>
                <DropShadowEffect Color="#FF2E93" BlurRadius="18" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏎️ DISNEY PIXAR — ARABALAR 1 (CARS 2006) // 1080P DUAL"
                               Foreground="#FF85C0"
                               FontSize="15"
                               FontWeight="ExtraBold"
                               VerticalAlignment="Center" />
                    <Border x:Name="HeaderSourceBadge"
                            Background="#1F0D33"
                            BorderBrush="#00E676"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="14,0,0,0">
                        <TextBlock x:Name="TxtHeaderSource"
                                   Text="⚡ YEREL DİSK (NVMe)"
                                   Foreground="#00E676"
                                   FontSize="10.5"
                                   FontWeight="Bold" />
                    </Border>
                    <Border Background="#2B0E38"
                            BorderBrush="#FF2E93"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="10,0,0,0">
                        <TextBlock Text="🎬 SİNEMA MODU"
                                   Foreground="#FF85C0"
                                   FontSize="10.5"
                                   FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <Button Content="✕ Tam Ekrandan Çık (Esc)"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PinkSecondaryButtonStyle}"
                        Padding="14,6"
                        FontSize="12"
                        Click="BtnExitFullscreen_Click" />
            </DockPanel>
        </Border>

        <!-- Bottom Cyber-Obsidian Floating Controls (Auto-hiding) -->
        <Border x:Name="BottomControlBar"
                VerticalAlignment="Bottom"
                Background="#CC0B0417"
                BorderBrush="#441757"
                BorderThickness="0,1,0,0"
                Padding="28,14">
            <Border.Effect>
                <DropShadowEffect Color="#FF2E93" BlurRadius="24" ShadowDepth="-2" Opacity="0.45" />
            </Border.Effect>
            <StackPanel>
                <!-- Seekbar Slider -->
                <Slider x:Name="TimelineSlider"
                        Style="{StaticResource PinkMediaSliderStyle}"
                        Margin="0,0,0,10"
                        PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                        PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                        ValueChanged="TimelineSlider_ValueChanged" />

                <!-- Buttons & Controls Row -->
                <DockPanel LastChildFill="False">
                    <!-- Left: Play/Pause, Skips, Time -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPlayPause"
                                Content="⏸ Duraklat"
                                Style="{StaticResource PinkPrimaryButtonStyle}"
                                Padding="16,7"
                                FontSize="12.5"
                                Margin="0,0,8,0"
                                Click="BtnPlayPause_Click" />

                        <Button Content="⏪ 10sn"
                                Style="{StaticResource PinkSecondaryButtonStyle}"
                                Padding="10,6"
                                FontSize="11.5"
                                Margin="0,0,6,0"
                                Click="BtnRewind10_Click" />

                        <Button Content="⏩ 10sn"
                                Style="{StaticResource PinkSecondaryButtonStyle}"
                                Padding="10,6"
                                FontSize="11.5"
                                Margin="0,0,14,0"
                                Click="BtnForward10_Click" />

                        <TextBlock x:Name="TxtTimeDisplay"
                                   Text="00:00:00 / 00:00:00"
                                   Foreground="#FFFFFF"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Loop, Volume, Exit -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnLoop"
                                Content="🔁 Döngü: Açık"
                                Style="{StaticResource PinkSecondaryButtonStyle}"
                                Padding="12,6"
                                FontSize="11.5"
                                Margin="0,0,16,0"
                                Click="BtnLoop_Click" />

                        <Button x:Name="BtnMute"
                                Content="🔊"
                                Style="{StaticResource PinkSecondaryButtonStyle}"
                                Padding="10,5"
                                FontSize="13"
                                Margin="0,0,8,0"
                                Click="BtnMute_Click" />

                        <Slider x:Name="VolumeSlider"
                                Width="100"
                                Minimum="0"
                                Maximum="1"
                                Value="0.5"
                                Style="{StaticResource PinkMediaSliderStyle}"
                                Margin="0,0,10,0"
                                ValueChanged="VolumeSlider_ValueChanged" />

                        <TextBlock x:Name="TxtVolumePercent"
                                   Text="50%"
                                   Foreground="#C4A8BC"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Width="38"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />

                        <Button Content="⛶ Çıkış"
                                Style="{StaticResource PinkSecondaryButtonStyle}"
                                Padding="12,6"
                                FontSize="12"
                                Click="BtnExitFullscreen_Click" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
