<UserControl x:Class="AlpTogether.Controls.CarsVideoPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="1100"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             IsVisibleChanged="UserControl_IsVisibleChanged">

    <Grid>
        <!-- ==================== 1. FULL EXPANDED VIDEO PLAYER BANNER ==================== -->
        <Border x:Name="ExpandedPlayerCard"
                Background="#13071F"
                BorderBrush="#FF2E93"
                BorderThickness="1.5"
                CornerRadius="16"
                ClipToBounds="True"
                Padding="0"
                Margin="0">
            <Border.Effect>
                <DropShadowEffect Color="#FF2E93" BlurRadius="22" ShadowDepth="0" Opacity="0.38" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TOP HEADER BAR -->
                <Border Grid.Row="0"
                        Background="#1B092C"
                        BorderBrush="#441757"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <DockPanel LastChildFill="False">
                        <!-- Left: Title & Badges -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏎️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="ARABALAR 1 (CARS 2006) // 1080P DUAL"
                                       Foreground="#FF85C0"
                                       FontSize="13.5"
                                       FontWeight="ExtraBold"
                                       VerticalAlignment="Center" />

                            <!-- Dynamic Source Badge (Local vs Cloud) -->
                            <Border x:Name="SourceBadgeBorder"
                                    Background="#1D0E30"
                                    BorderBrush="#00E676"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="7,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSourceBadge"
                                           Text="⚡ YEREL DİSK (NVMe)"
                                           Foreground="#00E676"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>

                            <!-- Dual Audio Badge -->
                            <Border Background="#2B0E38"
                                    BorderBrush="#FF5CAA"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="7,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="🔊 TÜRKÇE &amp; ENG DUAL"
                                           Foreground="#FFB2D8"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>

                            <!-- Size text -->
                            <TextBlock x:Name="TxtFileSize"
                                       Text="1.18 GB"
                                       Foreground="#A57A98"
                                       FontSize="11"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right: Actions & Tools -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <!-- Source Selector Button -->
                            <Button x:Name="BtnChangeSource"
                                    Content="📁 Kaynak"
                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                    Padding="10,4"
                                    FontSize="11"
                                    Margin="0,0,6,0"
                                    Click="BtnChangeSource_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Background="#1A0A2B" BorderBrush="#FF2E93" BorderThickness="1.2">
                                        <MenuItem Header="⚡ Otomatik Algıla (Yerel Disk Öncelikli)" Click="MenuSourceAuto_Click" Foreground="#FFFFFF" />
                                        <MenuItem Header="☁️ GitHub Release v1.1.0 Akışı (CDN Testi)" Click="MenuSourceCloud_Click" Foreground="#FFFFFF" />
                                        <MenuItem Header="📁 Bilgisayardan Özel .mp4 Seç..." Click="MenuSourceBrowse_Click" Foreground="#FFFFFF" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!-- Theater Mode Height Toggle -->
                            <Button x:Name="BtnToggleTheater"
                                    Content="📐 Sinema Boyutu"
                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                    Padding="10,4"
                                    FontSize="11"
                                    Margin="0,0,6,0"
                                    Click="BtnToggleTheater_Click" />

                            <!-- Fullscreen Button -->
                            <Button x:Name="BtnFullscreen"
                                    Content="🖥️ Tam Ekran"
                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                    Padding="10,4"
                                    FontSize="11"
                                    Margin="0,0,6,0"
                                    Click="BtnFullscreen_Click" />

                            <!-- Minimize / Collapse Banner Button -->
                            <Button x:Name="BtnCollapseBanner"
                                    Content="✕"
                                    Foreground="#C4A8BC"
                                    FontSize="13"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="6,4"
                                    Click="BtnCollapseBanner_Click"
                                    ToolTip="Oynatıcıyı simge durumuna küçült" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- MIDDLE: VIDEO VIEWPORT -->
                <Grid Grid.Row="1"
                      x:Name="VideoViewportContainer"
                      Height="270"
                      Background="#07020E"
                      ClipToBounds="True"
                      RenderOptions.BitmapScalingMode="Linear"
                      RenderOptions.EdgeMode="Aliased"
                      MouseLeftButtonDown="VideoViewport_MouseLeftButtonDown">

                    <!-- Hardware Accelerated MediaElement (EVR / Direct3D Bilinear) -->
                    <MediaElement x:Name="CarsMedia"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Close"
                                  ScrubbingEnabled="True"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderOptions.BitmapScalingMode="Linear"
                                  RenderOptions.EdgeMode="Aliased"
                                  MediaOpened="CarsMedia_MediaOpened"
                                  MediaEnded="CarsMedia_MediaEnded"
                                  MediaFailed="CarsMedia_MediaFailed"
                                  BufferingStarted="CarsMedia_BufferingStarted"
                                  BufferingEnded="CarsMedia_BufferingEnded" />

                    <!-- Ambient Speed Accent Hologram (When video is stopped or loading) -->
                    <Border x:Name="PosterBackdrop"
                            Background="#0E0518"
                            Visibility="Collapsed">
                        <Grid>
                            <Canvas IsHitTestVisible="False" Opacity="0.25">
                                <Rectangle Width="400" Height="2" Fill="#FF2E93" Canvas.Left="20" Canvas.Top="60" />
                                <Rectangle Width="600" Height="2" Fill="#FF5CAA" Canvas.Left="120" Canvas.Top="120" />
                                <Rectangle Width="500" Height="2" Fill="#00E676" Canvas.Left="50" Canvas.Top="190" />
                            </Canvas>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚡ 95" Foreground="#FF2E93" FontSize="42" FontWeight="Black" HorizontalAlignment="Center" />
                                <TextBlock Text="PIXAR ARABALAR 1 // KACHOW!" Foreground="#FF85C0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                <TextBlock Text="Oynatmak veya duraklatmak için tıklayın" Foreground="#A97E9C" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Center Big Play Button (Visible when paused) -->
                    <Border x:Name="CenterBigPlayOverlay"
                            Width="74" Height="74"
                            CornerRadius="37"
                            Background="#AA16072B"
                            BorderBrush="#FF2E93"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            MouseLeftButtonDown="CenterBigPlay_MouseLeftButtonDown">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF2E93" BlurRadius="22" ShadowDepth="0" Opacity="0.7" />
                        </Border.Effect>
                        <TextBlock Text="▶" Foreground="#FFFFFF" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </Border>

                    <!-- Loading / Buffering Indicator -->
                    <Border x:Name="BufferingIndicator"
                            Background="#CC0B0417"
                            CornerRadius="8"
                            Padding="12,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Video Yükleniyor / Arabelleğe Alınıyor..." Foreground="#FF85C0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Error / Fallback Alert Banner -->
                    <Border x:Name="ErrorFallbackPanel"
                            Background="#E61A0713"
                            BorderBrush="#FF1744"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚠️ Video Dosyası veya Akışı Yüklenemedi" Foreground="#FF5252" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock x:Name="TxtErrorMessage" Text="Yerel diskte belirtilen Cars MP4 dosyası bulunamadı." Foreground="#FCE4EC" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="📁 Yerel MP4 Seç" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,5" FontSize="11" Margin="0,0,8,0" Click="MenuSourceBrowse_Click" />
                                <Button Content="☁️ Buluttan Yeniden Dene" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="12,5" FontSize="11" Click="MenuSourceCloud_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Floating Toast Message (Auto-fading) -->
                    <Border x:Name="ToastNotificationBorder"
                            Background="#E61C0830"
                            BorderBrush="#FF2E93"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,12,0,0"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="TxtToastMessage" Text="⚡ Yerel Diskten Oynatılıyor" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" />
                    </Border>
                </Grid>

                <!-- BOTTOM CONTROLS BAR -->
                <Border Grid.Row="2"
                        Background="#170826"
                        BorderBrush="#441757"
                        BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <StackPanel>
                        <!-- Timeline Scrubber -->
                        <Slider x:Name="TimelineSlider"
                                Style="{StaticResource PinkMediaSliderStyle}"
                                Margin="0,0,0,8"
                                PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                                PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                                ValueChanged="TimelineSlider_ValueChanged" />

                        <!-- Button Controls Dock -->
                        <DockPanel LastChildFill="False">
                            <!-- Left Controls: Play/Pause, Skips, Duration -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnPlayPause"
                                        Content="⏸ Duraklat"
                                        Style="{StaticResource PinkPrimaryButtonStyle}"
                                        Padding="14,6"
                                        FontSize="12"
                                        Margin="0,0,8,0"
                                        Click="BtnPlayPause_Click" />

                                <Button Content="⏪ 10sn"
                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                        Padding="8,5"
                                        FontSize="11"
                                        Margin="0,0,5,0"
                                        Click="BtnRewind10_Click"
                                        ToolTip="10 saniye geri sar" />

                                <Button Content="⏩ 10sn"
                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                        Padding="8,5"
                                        FontSize="11"
                                        Margin="0,0,12,0"
                                        Click="BtnForward10_Click"
                                        ToolTip="10 saniye ileri sar" />

                                <TextBlock x:Name="TxtTimeDisplay"
                                           Text="00:00:00 / 00:00:00"
                                           Foreground="#FFFFFF"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right Controls: Loop, Mute/Volume -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnLoop"
                                        Content="🔁 Döngü: Açık"
                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                        Padding="10,5"
                                        FontSize="11"
                                        Margin="0,0,12,0"
                                        Click="BtnLoop_Click"
                                        ToolTip="Video bittiğinde baştan tekrar oynat" />

                                <Button x:Name="BtnMute"
                                        Content="🔇"
                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                        Padding="8,4"
                                        FontSize="13"
                                        Margin="0,0,6,0"
                                        Click="BtnMute_Click"
                                        ToolTip="Sesi Aç / Kapat" />

                                <Slider x:Name="VolumeSlider"
                                        Width="80"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0.5"
                                        Style="{StaticResource PinkMediaSliderStyle}"
                                        Margin="0,0,8,0"
                                        ValueChanged="VolumeSlider_ValueChanged"
                                        ToolTip="Ses Düzeyi" />

                                <TextBlock x:Name="TxtVolumePercent"
                                           Text="Sessiz"
                                           Foreground="#C4A8BC"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Width="40"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 2. COMPACT COLLAPSED MINI STRIP ==================== -->
        <Border x:Name="CollapsedMiniStrip"
                Background="#170928"
                BorderBrush="#FF2E93"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,6"
                Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏎️ Arabalar 1 (Cars 2006) Oynatıcı Simge Durumunda"
                               Foreground="#FF85C0"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtMiniTime"
                               Text=" (00:00)"
                               Foreground="#A57A98"
                               FontSize="11.5"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnMiniPlayPause"
                            Content="▶ Oynat"
                            Style="{StaticResource PinkSecondaryButtonStyle}"
                            Padding="10,3"
                            FontSize="11"
                            Margin="0,0,8,0"
                            Click="BtnPlayPause_Click" />

                    <Button Content="▲ Oynatıcıyı Göster"
                            Style="{StaticResource PinkPrimaryButtonStyle}"
                            Padding="12,4"
                            FontSize="11"
                            Click="BtnExpandBanner_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
