<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\Assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>AlpTogether.Setup</AssemblyName>
    <RootNamespace>AlpTogetherWebSetup</RootNamespace>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Product>AlpTogether Web Installer</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\Assets\alptogether_logo_pink.png" Link="Assets\alptogether_logo_pink.png" />
    <Resource Include="..\Assets\app_icon.ico" Link="Assets\app_icon.ico" />
  </ItemGroup>

</Project>
