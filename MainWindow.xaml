                        <!-- ==================== VIEW 4: REPAIR & INSTALL PATH MANAGER ==================== -->
                        <ScrollViewer x:Name="ViewRepairAndPaths" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
                            <StackPanel>
                                <TextBlock Text="🛠 Akıllı Hata Onarım ve Dosya Yolu Yönetim Merkezi"
                                           Foreground="#FFFFFF"
                                           FontSize="22"
                                           FontWeight="ExtraBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Uygulamaların kurulu olduğu klasörleri değiştirin, dosyaları başka bir diske taşıyın veya bozuk/eksik bileşenleri tek tıkla onarın."
                                           Foreground="#CCA6C0"
                                           FontSize="13"
                                           Margin="0,0,0,18" />

                                <!-- Global Default Install Root Card -->
                                <Border Background="{StaticResource PinkHeroBackdropBrush}"
                                        BorderBrush="#7A2866"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="20,16"
                                        Margin="0,0,0,18">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Width="680">
                                            <TextBlock Text="VARSAYILAN ANA KURULUM DİZİNİ" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" />
                                            <TextBlock x:Name="TxtDefaultRootPath" Text="C:\Users\...\AppData\Local\AlpTogether\Apps" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,4,0,4" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Yeni indirilen uygulamalar özel bir yol seçilmediği sürece bu klasör altına kurulur." Foreground="#C9A2BC" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="📁 Varsayılan Klasörü Değiştir" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="14,9" Margin="0,0,8,0" Click="BtnChangeDefaultRoot_Click" />
                                            <Button Content="🔧 Tüm Uygulamaları Тара &amp; Onar" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="14,9" Click="BtnRepairAllApps_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Per-App Path & Repair List -->
                                <ItemsControl x:Name="IcRepairAppsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#160B22" BorderBrush="#421D52" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="210" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="42" Height="42" CornerRadius="10" ClipToBounds="True">
                                                        <Image Source="{Binding IconPackUri}" Stretch="UniformToFill" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding HealthStatus}" Foreground="#00E676" FontSize="11.5" FontWeight="SemiBold" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,14,0">
                                                        <TextBlock Text="Kurulum Dosya Yolu:" Foreground="#9E7192" FontSize="10.5" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding InstallPath}" Foreground="#FFEAF5" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,2" />
                                                        <TextBlock Text="{Binding VersionDisplay}" Foreground="#C495B4" FontSize="11" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="📁 Dosya Yolu Değiştir / Taşı" Tag="{Binding}" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,0" Click="BtnCardChangePath_Click" />
                                                        <Button Content="📂 Klasörü Aç" Tag="{Binding}" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,0" Click="BtnCardOpenFolder_Click" />
                                                        <Button Content="🔧 Hata Varsa Onar" Tag="{Binding}" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="14,8" FontSize="12" Click="BtnCardRepair_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ==================== VIEW 5: CUSTOMIZABLE WORKSPACE SLOT & LIVE LOGS ("Sonradan Değiştirilebilir Boşluk + Log") ==================== -->
                        <Grid x:Name="ViewCustomLogs" Visibility="Collapsed" Margin="22,18,22,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Real-Time Activity & Telemetry Log Stream -->
                            <Border Grid.Column="0"
                                    Background="#13091F"
                                    BorderBrush="#491F59"
                                    BorderThickness="1.2"
                                    CornerRadius="14"
                                    Padding="18,16"
                                    Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="▤ Canlı Sistem, Kurulum ve Telemetri Log Konsolu"
                                                       Foreground="#FFFFFF"
                                                       FontSize="17"
                                                       FontWeight="ExtraBold" />
                                            <TextBlock Text="Tüm indirme, hibrit kurulum, onarım ve anlık hata bildirimleri gerçek zamanlı olarak buraya düşer."
                                                       Foreground="#C49AB6"
                                                       FontSize="11.5" />
                                        </StackPanel>
                                    </DockPanel>

                                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                                        <Button Content="📋 Logları Kopyala" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,4" Click="BtnCopyLogs_Click" />
                                        <Button Content="📂 Log Klasörünü Aç" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,4" Click="BtnOpenLogFolder_Click" />
                                        <Button Content="🗑 Temizle" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,4" Click="BtnClearLogs_Click" />
                                        <Button Content="⚡ Test: Anlık Hata Telemetrisi Gönder" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,0,4" Click="BtnTestAutoErrorTelemetry_Click" />
                                    </WrapPanel>

                                    <ListBox x:Name="LstLiveLogs"
                                             Grid.Row="2"
                                             Background="#0D0616"
                                             BorderBrush="#32153F"
                                             BorderThickness="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#160B24" BorderBrush="#2D143C" BorderThickness="0,0,0,1" Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="62" />
                                                            <ColumnDefinition Width="95" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TimeText}" Foreground="#9E7394" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Background="#251036" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" Foreground="#FF85C0" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding AppName}" Foreground="#FFD4EB" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="{Binding Message}" Foreground="#FFF5FA" FontSize="12" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Details}" Foreground="#A87F9D" FontSize="10.5" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Customizable Dynamic Workspace Slot ("Sonradan Değiştirilebilir Boşluk Alanı") -->
                            <Border Grid.Column="1"
                                    Background="{StaticResource PinkCardGlassBrush}"
                                    BorderBrush="#FF2E93"
                                    BorderThickness="1.2"
                                    CornerRadius="14"
                                    Padding="18,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <Border Background="#FF2E93" CornerRadius="5" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="MODÜLER ALAN" Foreground="#FFFFFF" FontSize="10" FontWeight="ExtraBold" />
                                        </Border>
                                        <TextBlock Text="Sonradan Değiştirilebilir Özel Boşluk &amp; Not Alanı"
                                                   Foreground="#FFFFFF"
                                                   FontSize="15.5"
                                                   FontWeight="ExtraBold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="Bu bölüm; ileride eklemek istediğiniz özel modüller, sunucu duyuruları, hızlı komutlar veya geliştirici log/notları için dinamik olarak tasarlanmıştır."
                                               Foreground="#C9A2BC"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />

                                    <!-- Add New Custom Slot Card Row -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtNewSlotTitle" Style="{StaticResource PinkTextBoxStyle}" ToolTip="Özel Kart Başlığı" Margin="0,0,6,0" />
                                        <TextBox x:Name="TxtNewSlotContent" Grid.Column="1" Style="{StaticResource PinkTextBoxStyle}" ToolTip="Özel Kart İçeriği veya Notu" Margin="0,0,6,0" />
                                        <Button Grid.Column="2" Content="+ Kart Ekle" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="12,7" FontSize="11.5" Click="BtnAddCustomSlotCard_Click" />
                                    </Grid>

                                    <!-- Dynamic Slot Cards + Editable Scratchpad -->
                                    <Grid Grid.Row="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1.1*" />
                                            <RowDefinition Height="0.9*" />
                                        </Grid.RowDefinitions>

                                        <ListBox x:Name="LstCustomSlotItems"
                                                 Grid.Row="0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Margin="0,0,0,10">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1A0C28" BorderBrush="#52215E" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="✕" Tag="{Binding}" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="7,2" FontSize="10" VerticalAlignment="Top" Click="BtnDeleteCustomSlotCard_Click" />
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                    <TextBlock Text="{Binding Title}" Foreground="#FF85C0" FontSize="12.5" FontWeight="Bold" />
                                                                    <TextBlock Text="{Binding CreatedAt, StringFormat=' • {0}'}" Foreground="#8E6583" FontSize="10.5" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Content}" Foreground="#EFE0EA" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="Serbest Değiştirilebilir Boşluk / Kalıcı Not &amp; Log Defteri:"
                                                       Foreground="#FF85C0"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,5" />
                                            <TextBox x:Name="TxtCustomScratchpad"
                                                     Style="{StaticResource PinkTextBoxStyle}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Height="125" />
                                        </StackPanel>
                                    </Grid>

                                    <Button Grid.Row="4"
                                            Content="💾 Özel Boşluk Değişikliklerini Kaydet"
                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                            Margin="0,10,0,0"
                                            Click="BtnSaveCustomScratchpad_Click" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ==================== VIEW 6: HELP, BUG REPORT & INSTANT TELEMETRY CENTER ==================== -->
                        <ScrollViewer x:Name="ViewHelpAndFeedback" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: User Bug & Issue Reporting Form ("Bize Ulaşabilecekleri Help / Bu Bozuk Bildirimi") -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource PinkHeroBackdropBrush}"
                                        BorderBrush="#FF2E93"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        Padding="22,20"
                                        Margin="0,0,16,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="CANLI DESTEK &amp; ARIZA BİLDİRİMİ" Foreground="#FFFFFF" FontSize="10.5" FontWeight="ExtraBold" />
                                            </Border>
                                        </DockPanel>

                                        <TextBlock Text="💬 Yardım Merkezi &amp; Sorun Bildirimi"
                                                   Foreground="#FFFFFF"
                                                   FontSize="22"
                                                   FontWeight="ExtraBold"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="Herhangi bir uygulamada 'bu bozuk, şunda sıkıntı var, açılmıyor veya güncelleme hatası veriyor' dediğiniz durumu anında bize iletin."
                                                   Foreground="#D9B6CD"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,16" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Sorun Yaşanan Uygulama:" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                                <ComboBox x:Name="CmbFeedbackApp" Height="36" FontSize="12.5" SelectedIndex="0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Sorun Kategorisi:" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                                <ComboBox x:Name="CmbFeedbackCategory" Height="36" FontSize="12.5" SelectedIndex="0">
                                                    <ComboBoxItem Content="Uygulama Açılmıyor / Çöküyor (Crash)" />
                                                    <ComboBoxItem Content="Bu Özellik Bozuk / Düzgün Çalışmıyor" />
                                                    <ComboBoxItem Content="İndirme veya Hibrit Kurulum Hatası" />
                                                    <ComboBoxItem Content="Güncelleme / Sürüm Doğrulama Sorunu" />
                                                    <ComboBoxItem Content="Performans / Donma / Arayüz Sorunu" />
                                                    <ComboBoxItem Content="Yeni Özellik İsteği / Öneri" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Aciliyet / Önem Derecesi:" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                                <ComboBox x:Name="CmbFeedbackSeverity" Height="36" FontSize="12.5" SelectedIndex="1">
                                                    <ComboBoxItem Content="Normal — Kullanımı Engellemiyor" />
                                                    <ComboBoxItem Content="Yüksek — Önemli Bir Özellik Bozuk" />
                                                    <ComboBoxItem Content="Kritik — Uygulama Hiç Çalışmıyor" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Size Ulaşabileceğimiz İletişim (Discord / E-posta / Tel):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                                <TextBox x:Name="TxtFeedbackContact" Style="{StaticResource PinkTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Kısa Başlık (Örn: AlpNet ses çevirisi açılırken hata veriyor):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtFeedbackSubject" Style="{StaticResource PinkTextBoxStyle}" Margin="0,0,0,12" />

                                        <TextBlock Text="Detaylı Açıklama (Ne yaparken oldu, hangi hatayı aldınız?):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtFeedbackDescription"
                                                 Style="{StaticResource PinkTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="110"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,12" />

                                        <CheckBox x:Name="ChkAttachSystemLogs"
                                                  Content="Son işlem loglarını ve cihaz tanı bilgilerini otomatik ekle (Hızlı çözüm için önerilir)"
                                                  Foreground="#FFEAF5"
                                                  FontSize="12"
                                                  IsChecked="True"
                                                  Margin="0,0,0,16" />

                                        <WrapPanel>
                                            <Button Content="🚀 Bildirimi Anında Gönder"
                                                    Style="{StaticResource PinkPrimaryButtonStyle}"
                                                    Padding="22,12"
                                                    FontSize="14"
                                                    Margin="0,0,10,8"
                                                    Click="BtnSubmitFeedback_Click" />

                                            <Button Content="💬 WhatsApp Hızlı Destek"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="14,12"
                                                    Margin="0,0,10,8"
                                                    Click="BtnWhatsAppSupport_Click" />

                                            <Button Content="🌐 GitHub Issues"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="14,12"
                                                    Margin="0,0,0,8"
                                                    Click="BtnOpenGitHubIssues_Click" />
                                        </WrapPanel>

                                        <TextBlock x:Name="TxtFeedbackResultStatus"
                                                   Text=""
                                                   Foreground="#00E676"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Right: Live Developer Telemetry & Incoming User Tickets Inbox -->
                                <Border Grid.Column="1"
                                        Background="#140A20"
                                        BorderBrush="#461F56"
                                        BorderThickness="1.2"
                                        CornerRadius="16"
                                        Padding="20,18">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="📡 Canlı Bildirim &amp; Anlık Hata Akışı"
                                                       Foreground="#FFFFFF"
                                                       FontSize="17"
                                                       FontWeight="ExtraBold"
                                                       VerticalAlignment="Center" />
                                            <Button Content="🔄 Yenile"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="10,5"
                                                    HorizontalAlignment="Right"
                                                    Click="BtnRefreshTelemetryInbox_Click" />
                                        </DockPanel>

                                        <TextBlock Text="Kullanıcılar hata aldığı an otomatik düşen çökme raporları (Auto-Crash Telemetry) ve gönderilen 'Bozuk / Sorun Var' bildirimleri:"
                                                   Foreground="#C49AB6"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />

                                        <TextBlock Text="SON KULLANICI BİLDİRİMLERİ (TICKETS):"
                                                   Foreground="#FF85C0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,6" />

                                        <ItemsControl x:Name="IcIncomingTickets" MaxHeight="260">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1D0F2E" BorderBrush="#52215F" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding TargetAppName}" Foreground="#FF5CAA" FontSize="12.5" FontWeight="ExtraBold" />
                                                                <TextBlock Text="{Binding Timestamp}" Foreground="#9C7190" FontSize="10.5" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Subject}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold" Margin="0,2,0,2" />
                                                            <TextBlock Text="{Binding Description}" Foreground="#D9BDD0" FontSize="11.5" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding IssueCategory, StringFormat='Kategori: {0}'}" Foreground="#00E676" FontSize="10.5" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="OTOMATİK ANLIK HATA RAPORLARI (AUTO-TELEMETRY):"
                                                   Foreground="#FF85C0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="10,8,0,6" />

                                        <ItemsControl x:Name="IcIncomingErrors" MaxHeight="240">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#230D24" BorderBrush="#801B4B" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding AppName}" Foreground="#FF4081" FontSize="12" FontWeight="ExtraBold" />
                                                                <TextBlock Text="{Binding Timestamp}" Foreground="#A67695" FontSize="10.5" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF0F6" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,2" />
                                                            <TextBlock Text="{Binding ErrorSource, StringFormat='Kaynak: {0}'}" Foreground="#FF94C8" FontSize="10.5" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- ==================== VIEW 7: DEVELOPER APP PUBLISHER & CLIENT SETTINGS ==================== -->
                        <ScrollViewer x:Name="ViewPublisherAndSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Developer App Publisher ("Yeni Uygulama Geliştiririm Yayınlarım AlpTogether'a Gelir") -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource PinkHeroBackdropBrush}"
                                        BorderBrush="#FF2E93"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        Padding="22,20"
                                        Margin="0,0,16,0">
                                    <StackPanel>
                                        <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                                            <TextBlock Text="GELİŞTİRİCİ YAYINLAMA STÜDYOSU" Foreground="#FFFFFF" FontSize="10.5" FontWeight="ExtraBold" />
                                        </Border>

                                        <TextBlock Text="🚀 Yeni Uygulama veya Yeni Sürüm Yayınla"
                                                   Foreground="#FFFFFF"
                                                   FontSize="21"
                                                   FontWeight="ExtraBold"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="Yeni bir uygulama geliştirdiğinizde veya mevcut bir uygulamaya güncelleme çıkardığınızda buradan yayınlayın; anında tüm AlpTogether kullanıcılarına düşer!"
                                                   Foreground="#D9B6CD"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,14" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Uygulama Adı (Örn: AlpStudio Pro):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubAppName" Style="{StaticResource PinkTextBoxStyle}" Text="AlpStudio Pro" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                <TextBlock Text="Yeni Sürüm:" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubVersion" Style="{StaticResource PinkTextBoxStyle}" Text="1.0.0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                <TextBlock Text="Kategori:" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubCategory" Style="{StaticResource PinkTextBoxStyle}" Text="Sistem &amp; Araçlar" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Ana Çalıştırılabilir .exe Adı (Örn: AlpStudio.exe):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubExeName" Style="{StaticResource PinkTextBoxStyle}" Text="AlpStudio.exe" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Varsayılan Alt Klasör &amp; Boyut (Örn: 48.5 MB):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubSizeText" Style="{StaticResource PinkTextBoxStyle}" Text="48.5 MB" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Doğrudan Paket İndirme Linki (GitHub Release .exe veya .zip URL):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPubDirectUrl" Style="{StaticResource PinkTextBoxStyle}" Text="https://github.com/alphankilicaslan/AlpTogether/releases/download/v1.0/AlpStudio.exe" Margin="0,0,0,10" />

                                        <TextBlock Text="Varsa Kendi Kurulum Aracı (Hibrit Setup.exe / MSI URL - Opsiyonel):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPubInstallerUrl" Style="{StaticResource PinkTextBoxStyle}" Text="" Margin="0,0,0,10" />

                                        <TextBlock Text="Kısa Açıklama:" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPubDescription" Style="{StaticResource PinkTextBoxStyle}" Height="56" TextWrapping="Wrap" AcceptsReturn="True" Text="AlpTogether ekosistemi için geliştirilmiş yeni nesil yüksek performanslı masaüstü uygulaması." Margin="0,0,0,10" />

                                        <TextBlock Text="Son Yenilikler / Yama Notları (Her satır bir madde olarak görünür):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPubPatchNotes" Style="{StaticResource PinkTextBoxStyle}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" Text="İlk kararlı sürüm yayınlandı.&#x0a;Hibrit güncelleme ve otomatik onarım desteği eklendi." Margin="0,0,0,14" />

                                        <WrapPanel>
                                            <Button Content="🔥 Kataloğa Yayınla (Bulut + GitHub catalog.json)"
                                                    Style="{StaticResource PinkPrimaryButtonStyle}"
                                                    Padding="20,12"
                                                    FontSize="13.5"
                                                    Margin="0,0,10,6"
                                                    Click="BtnPublishNewApp_Click" />

                                            <Button Content="📂 Yerel .exe Seçip Bilgileri Doldur"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="14,12"
                                                    Margin="0,0,0,6"
                                                    Click="BtnPickLocalExeForPublish_Click" />
                                        </WrapPanel>

                                        <TextBlock x:Name="TxtPublishResultStatus"
                                                   Text=""
                                                   Foreground="#00E676"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Right: Cloud, Webhook & Client Settings -->
                                <Border Grid.Column="1"
                                        Background="#140A20"
                                        BorderBrush="#461F56"
                                        BorderThickness="1.2"
                                        CornerRadius="16"
                                        Padding="20,18">
                                    <StackPanel>
                                        <TextBlock Text="⚙ Bulut, GitHub &amp; Telemetri Ayarları"
                                                   Foreground="#FFFFFF"
                                                   FontSize="18"
                                                   FontWeight="ExtraBold"
                                                   Margin="0,0,0,12" />

                                        <TextBlock Text="GitHub Raw Katalog Adresi (catalog.json):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSettingGitHubCatalog" Style="{StaticResource PinkTextBoxStyle}" Margin="0,0,0,12" />

                                        <TextBlock Text="Firebase Realtime Database Adresi (Canlı Katalog &amp; Hata Bildirimi):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSettingFirebaseUrl" Style="{StaticResource PinkTextBoxStyle}" Margin="0,0,0,12" />

                                        <TextBlock Text="Özel Discord / Telegram Webhook URL (Anlık Hata &amp; Ticket Bildirimi İçin):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSettingWebhookUrl" Style="{StaticResource PinkTextBoxStyle}" Margin="0,0,0,14" />

                                        <CheckBox x:Name="ChkSettingAutoTelemetry"
                                                  Content="Kullanıcı hata aldığında anında otomatik hata raporu gönder"
                                                  Foreground="#FFEAF5"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,10" />

                                        <CheckBox x:Name="ChkSettingMonitorChildCrashes"
                                                  Content="AlpTogether içinden başlatılan uygulamaların çökmelerini (Crash) izle"
                                                  Foreground="#FFEAF5"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,10" />

                                        <CheckBox x:Name="ChkSettingDesktopShortcut"
                                                  Content="Kurulum ve onarım sonrasında masaüstü kısayolu oluştur"
                                                  Foreground="#FFEAF5"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,18" />

                                        <Button Content="💾 Tüm İstemci Ayarlarını Kaydet"
                                                Style="{StaticResource PinkPrimaryButtonStyle}"
                                                Padding="16,11"
                                                Click="BtnSaveSettings_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                    </Grid>

                    <!-- 4. BOTTOM COLLAPSIBLE LIVE LOG & TELEMETRY STATUS BAR -->
                    <Border Grid.Row="3"
                            Background="#10071A"
                            BorderBrush="#331742"
                            BorderThickness="0,1,0,0"
                            Padding="18,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#FF2E93" Margin="0,0,8,0" />
                                <TextBlock Text="SON İŞLEM LOGU:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBottomLiveLog"
                                           Text="AlpTogether hazır."
                                           Foreground="#E6C6DA"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="720" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="▤ Özel Boşluk &amp; Log Konsolunu Aç"
                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Click="BtnNavCustomLogs_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
