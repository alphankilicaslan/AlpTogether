                        </ScrollViewer>

                        <!-- ==================== VIEW 3: PATCH NOTES & CHANGELOG ==================== -->
                        <ScrollViewer x:Name="ViewChangelog" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
                            <StackPanel>
                                <TextBlock Text="✦ Son Yenilikler, Sürüm Geçmişi ve Yama Notları"
                                           Foreground="#FFFFFF"
                                           FontSize="22"
                                           FontWeight="ExtraBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="AlpTogether ekosistemindeki tüm uygulamaların son güncellemelerini, yeni özelliklerini ve hata düzeltmelerini buradan takip edin."
                                           Foreground="#CCA6C0"
                                           FontSize="13"
                                           Margin="0,0,0,18" />

                                <ItemsControl x:Name="IcAllPatchNotes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PinkCardGlassBrush}"
                                                    BorderBrush="#4A2059"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="20,16"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Details & Changes -->
                                                    <StackPanel Grid.Column="0">
                                                        <DockPanel Margin="0,0,0,8">
                                                            <Border Width="24" Height="24" CornerRadius="6" Background="#16081F" BorderBrush="#551D4B" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
                                                                <Image Source="{Binding AppIconUri}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Border>
                                                            <Border Background="#FF2E93" CornerRadius="6" Padding="9,3" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding AppName}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="ExtraBold" />
                                                            </Border>
                                                            <Border Background="#2D133E" BorderBrush="#FF5CAA" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Version, StringFormat=Sürüm v{0}}" Foreground="#FF94C8" FontSize="11.5" FontWeight="Bold" />
                                                            </Border>
                                                            <Border Background="#211030" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Tag}" Foreground="#00E676" FontSize="10.5" FontWeight="Bold" />
                                                            </Border>
                                                            <TextBlock Text="{Binding ReleaseDate}" Foreground="#B88AA9" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </DockPanel>

                                                        <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

                                                        <ItemsControl ItemsSource="{Binding Changes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                                                        <TextBlock Text="✦ " Foreground="#FF5CAA" FontWeight="Bold" />
                                                                        <TextBlock Text="{Binding}" Foreground="#E6C9DC" FontSize="13" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- Patch Note Image (Opsiyonel / Admin Yüklemesi) -->
                                                    <Border Grid.Column="1"
                                                            Margin="16,0,0,0"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            Width="110" Height="82"
                                                            CornerRadius="12"
                                                            Background="#180722"
                                                            BorderBrush="#5E1E50"
                                                            BorderThickness="1.5"
                                                            ClipToBounds="True"
                                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#FF2E93" BlurRadius="12" ShadowDepth="0" Opacity="0.3" />
                                                        </Border.Effect>
                                                        <Image Source="{Binding ImageUrl}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ==================== VIEW 4: REPAIR & INSTALL PATH MANAGER ==================== -->
                        <ScrollViewer x:Name="ViewRepairAndPaths" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
                            <StackPanel>
                                <TextBlock Text="🛠 Akıllı Hata Onarım ve Dosya Yolu Yönetim Merkezi"
                                           Foreground="#FFFFFF"
                                           FontSize="22"
                                           FontWeight="ExtraBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Uygulamaların kurulu olduğu klasörleri değiştirin, dosyaları başka bir diske taşıyın veya bozuk/eksik bileşenleri tek tıkla onarın."
                                           Foreground="#CCA6C0"
                                           FontSize="13"
                                           Margin="0,0,0,18" />

                                <!-- Global Default Install Root Card -->
                                <Border Background="{StaticResource PinkHeroBackdropBrush}"
                                        BorderBrush="#7A2866"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="20,16"
                                        Margin="0,0,0,18">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Width="680">
                                            <TextBlock Text="VARSAYILAN ANA KURULUM DİZİNİ" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" />
                                            <TextBlock x:Name="TxtDefaultRootPath" Text="C:\Users\...\AppData\Local\AlpTogether\Apps" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,4,0,4" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Yeni indirilen uygulamalar özel bir yol seçilmediği sürece bu klasör altına kurulur." Foreground="#C9A2BC" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="📁 Varsayılan Klasörü Değiştir" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="14,9" Margin="0,0,8,0" Click="BtnChangeDefaultRoot_Click" />
                                            <Button Content="🔧 Tüm Uygulamaları Тара &amp; Onar" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="14,9" Click="BtnRepairAllApps_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Per-App Path & Repair List -->
                                <ItemsControl x:Name="IcRepairAppsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#160B22" BorderBrush="#421D52" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="210" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="42" Height="42" CornerRadius="10" ClipToBounds="True">
                                                        <Image Source="{Binding IconPackUri}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding HealthStatus}" Foreground="#00E676" FontSize="11.5" FontWeight="SemiBold" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,14,0">
                                                        <TextBlock Text="Kurulum Dosya Yolu:" Foreground="#9E7192" FontSize="10.5" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding InstallPath}" Foreground="#FFEAF5" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,2" />
                                                        <TextBlock Text="{Binding VersionDisplay}" Foreground="#C495B4" FontSize="11" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="📁 Dosya Yolu Değiştir / Taşı" Tag="{Binding}" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,0" Click="BtnCardChangePath_Click" />
                                                        <Button Content="📂 Klasörü Aç" Tag="{Binding}" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,0" Click="BtnCardOpenFolder_Click" />
                                                        <Button Content="🔧 Hata Varsa Onar" Tag="{Binding}" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="14,8" FontSize="12" Click="BtnCardRepair_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ==================== VIEW 5: CUSTOMIZABLE WORKSPACE SLOT & LIVE LOGS ("Sonradan Değiştirilebilir Boşluk + Log") ==================== -->
                        <Grid x:Name="ViewCustomLogs" Visibility="Collapsed" Margin="22,18,22,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Real-Time Activity & Telemetry Log Stream -->
                            <Border Grid.Column="0"
                                    Background="#13091F"
                                    BorderBrush="#491F59"
                                    BorderThickness="1.2"
                                    CornerRadius="14"
                                    Padding="18,16"
                                    Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="▤ Canlı Sistem, Kurulum ve Telemetri Log Konsolu"
                                                       Foreground="#FFFFFF"
                                                       FontSize="17"
                                                       FontWeight="ExtraBold" />
                                            <TextBlock Text="Tüm indirme, hibrit kurulum, onarım ve anlık hata bildirimleri gerçek zamanlı olarak buraya düşer."
                                                       Foreground="#C49AB6"
                                                       FontSize="11.5" />
                                        </StackPanel>
                                    </DockPanel>

                                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                                        <Button Content="📋 Logları Kopyala" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,4" Click="BtnCopyLogs_Click" />
                                        <Button Content="📂 Log Klasörünü Aç" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,4" Click="BtnOpenLogFolder_Click" />
                                        <Button Content="🗑 Temizle" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,4" Click="BtnClearLogs_Click" />
                                        <Button Content="⚡ Test: Anlık Hata Telemetrisi Gönder" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,0,4" Click="BtnTestAutoErrorTelemetry_Click" />
                                    </WrapPanel>

                                    <ListBox x:Name="LstLiveLogs"
                                             Grid.Row="2"
                                             Background="#0D0616"
                                             BorderBrush="#32153F"
                                             BorderThickness="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#160B24" BorderBrush="#2D143C" BorderThickness="0,0,0,1" Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="62" />
                                                            <ColumnDefinition Width="95" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TimeText}" Foreground="#9E7394" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Background="#251036" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" Foreground="#FF85C0" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding AppName}" Foreground="#FFD4EB" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="{Binding Message}" Foreground="#FFF5FA" FontSize="12" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Details}" Foreground="#A87F9D" FontSize="10.5" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Customizable Dynamic Workspace Slot ("Sonradan Değiştirilebilir Boşluk Alanı") -->
                            <Border Grid.Column="1"
                                    Background="{StaticResource PinkCardGlassBrush}"
                                    BorderBrush="#FF2E93"
                                    BorderThickness="1.2"
                                    CornerRadius="14"
                                    Padding="18,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <Border Background="#FF2E93" CornerRadius="5" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="MODÜLER ALAN" Foreground="#FFFFFF" FontSize="10" FontWeight="ExtraBold" />
                                        </Border>
                                        <TextBlock Text="Sonradan Değiştirilebilir Özel Boşluk &amp; Not Alanı"
                                                   Foreground="#FFFFFF"
                                                   FontSize="15.5"
                                                   FontWeight="ExtraBold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="Bu bölüm; ileride eklemek istediğiniz özel modüller, sunucu duyuruları, hızlı komutlar veya geliştirici log/notları için dinamik olarak tasarlanmıştır."
                                               Foreground="#C9A2BC"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />

                                    <!-- Add New Custom Slot Card Row -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtNewSlotTitle" Style="{StaticResource PinkTextBoxStyle}" ToolTip="Özel Kart Başlığı" Margin="0,0,6,0" />
                                        <TextBox x:Name="TxtNewSlotContent" Grid.Column="1" Style="{StaticResource PinkTextBoxStyle}" ToolTip="Özel Kart İçeriği veya Notu" Margin="0,0,6,0" />
                                        <Button Grid.Column="2" Content="+ Kart Ekle" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="12,7" FontSize="11.5" Click="BtnAddCustomSlotCard_Click" />
                                    </Grid>

                                    <!-- Dynamic Slot Cards + Editable Scratchpad -->
                                    <Grid Grid.Row="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1.1*" />
                                            <RowDefinition Height="0.9*" />
                                        </Grid.RowDefinitions>

                                        <ListBox x:Name="LstCustomSlotItems"
                                                 Grid.Row="0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Margin="0,0,0,10">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1A0C28" BorderBrush="#52215E" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="✕" Tag="{Binding}" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="7,2" FontSize="10" VerticalAlignment="Top" Click="BtnDeleteCustomSlotCard_Click" />
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                    <TextBlock Text="{Binding Title}" Foreground="#FF85C0" FontSize="12.5" FontWeight="Bold" />
                                                                    <TextBlock Text="{Binding CreatedAt, StringFormat=' • {0}'}" Foreground="#8E6583" FontSize="10.5" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Content}" Foreground="#EFE0EA" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="Serbest Değiştirilebilir Boşluk / Kalıcı Not &amp; Log Defteri:"
                                                       Foreground="#FF85C0"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,5" />
                                            <TextBox x:Name="TxtCustomScratchpad"
                                                     Style="{StaticResource PinkTextBoxStyle}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Height="125" />
                                        </StackPanel>
                                    </Grid>

                                    <Button Grid.Row="4"
                                            Content="💾 Özel Boşluk Değişikliklerini Kaydet"
                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                            Margin="0,10,0,0"
                                            Click="BtnSaveCustomScratchpad_Click" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ==================== VIEW 6: HELP, BUG REPORT & INSTANT TELEMETRY CENTER ==================== -->
                        <ScrollViewer x:Name="ViewHelpAndFeedback" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: User Bug & Issue Reporting Form ("Bize Ulaşabilecekleri Help / Bu Bozuk Bildirimi") -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource PinkHeroBackdropBrush}"
                                        BorderBrush="#FF2E93"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        Padding="22,20"
                                        Margin="0,0,16,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="CANLI DESTEK &amp; ARIZA BİLDİRİMİ" Foreground="#FFFFFF" FontSize="10.5" FontWeight="ExtraBold" />
                                            </Border>
                                        </DockPanel>

                                        <TextBlock Text="💬 Yardım Merkezi &amp; Sorun Bildirimi"
                                                   Foreground="#FFFFFF"
                                                   FontSize="22"
                                                   FontWeight="ExtraBold"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="Herhangi bir uygulamada 'bu bozuk, şunda sıkıntı var, açılmıyor veya güncelleme hatası veriyor' dediğiniz durumu anında bize iletin."
                                                   Foreground="#D9B6CD"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,16" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Sorun Yaşanan Uygulama:" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                                <ComboBox x:Name="CmbFeedbackApp" Height="36" FontSize="12.5" SelectedIndex="0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Sorun Kategorisi:" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                                <ComboBox x:Name="CmbFeedbackCategory" Height="36" FontSize="12.5" SelectedIndex="0">
                                                    <ComboBoxItem Content="Uygulama Açılmıyor / Çöküyor (Crash)" />
                                                    <ComboBoxItem Content="Bu Özellik Bozuk / Düzgün Çalışmıyor" />
                                                    <ComboBoxItem Content="İndirme veya Hibrit Kurulum Hatası" />
                                                    <ComboBoxItem Content="Güncelleme / Sürüm Doğrulama Sorunu" />
                                                    <ComboBoxItem Content="Performans / Donma / Arayüz Sorunu" />
                                                    <ComboBoxItem Content="Yeni Özellik İsteği / Öneri" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Aciliyet / Önem Derecesi:" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                                <ComboBox x:Name="CmbFeedbackSeverity" Height="36" FontSize="12.5" SelectedIndex="1">
                                                    <ComboBoxItem Content="Normal — Kullanımı Engellemiyor" />
                                                    <ComboBoxItem Content="Yüksek — Önemli Bir Özellik Bozuk" />
                                                    <ComboBoxItem Content="Kritik — Uygulama Hiç Çalışmıyor" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Size Ulaşabileceğimiz İletişim (Discord / E-posta / Tel):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                                <TextBox x:Name="TxtFeedbackContact" Style="{StaticResource PinkTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Kısa Başlık (Örn: AlpNet ses çevirisi açılırken hata veriyor):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtFeedbackSubject" Style="{StaticResource PinkTextBoxStyle}" Margin="0,0,0,12" />

                                        <TextBlock Text="Detaylı Açıklama (Ne yaparken oldu, hangi hatayı aldınız?):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,5" />
                                        <TextBox x:Name="TxtFeedbackDescription"
                                                 Style="{StaticResource PinkTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="110"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,12" />

                                        <CheckBox x:Name="ChkAttachSystemLogs"
                                                  Content="Son işlem loglarını ve cihaz tanı bilgilerini otomatik ekle (Hızlı çözüm için önerilir)"
                                                  Foreground="#FFEAF5"
                                                  FontSize="12"
                                                  IsChecked="True"
                                                  Margin="0,0,0,16" />

                                        <WrapPanel>
                                            <Button Content="🚀 Bildirimi Anında Gönder"
                                                    Style="{StaticResource PinkPrimaryButtonStyle}"
                                                    Padding="22,12"
                                                    FontSize="14"
                                                    Margin="0,0,10,8"
                                                    Click="BtnSubmitFeedback_Click" />

                                            <Button Content="💬 WhatsApp Hızlı Destek"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="14,12"
                                                    Margin="0,0,10,8"
                                                    Click="BtnWhatsAppSupport_Click" />

                                            <Button Content="🌐 GitHub Issues"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="14,12"
                                                    Margin="0,0,0,8"
                                                    Click="BtnOpenGitHubIssues_Click" />
                                        </WrapPanel>

                                        <TextBlock x:Name="TxtFeedbackResultStatus"
                                                   Text=""
                                                   Foreground="#00E676"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Right: Live Developer Telemetry & Incoming User Tickets Inbox -->
                                <Border Grid.Column="1"
                                        Background="#140A20"
                                        BorderBrush="#461F56"
                                        BorderThickness="1.2"
                                        CornerRadius="16"
                                        Padding="20,18">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="📡 Canlı Bildirim &amp; Anlık Hata Akışı"
                                                       Foreground="#FFFFFF"
                                                       FontSize="17"
                                                       FontWeight="ExtraBold"
                                                       VerticalAlignment="Center" />
                                            <Button Content="🔄 Yenile"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="10,5"
                                                    HorizontalAlignment="Right"
                                                    Click="BtnRefreshTelemetryInbox_Click" />
                                        </DockPanel>

                                        <TextBlock Text="Kullanıcılar hata aldığı an otomatik düşen çökme raporları (Auto-Crash Telemetry) ve gönderilen 'Bozuk / Sorun Var' bildirimleri:"
                                                   Foreground="#C49AB6"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />

                                        <TextBlock Text="SON KULLANICI BİLDİRİMLERİ (TICKETS):"
                                                   Foreground="#FF85C0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,6" />

                                        <ItemsControl x:Name="IcIncomingTickets" MaxHeight="260">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1D0F2E" BorderBrush="#52215F" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding TargetAppName}" Foreground="#FF5CAA" FontSize="12.5" FontWeight="ExtraBold" />
                                                                <TextBlock Text="{Binding Timestamp}" Foreground="#9C7190" FontSize="10.5" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Subject}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold" Margin="0,2,0,2" />
                                                            <TextBlock Text="{Binding Description}" Foreground="#D9BDD0" FontSize="11.5" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding IssueCategory, StringFormat='Kategori: {0}'}" Foreground="#00E676" FontSize="10.5" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="OTOMATİK ANLIK HATA RAPORLARI (AUTO-TELEMETRY):"
                                                   Foreground="#FF85C0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="10,8,0,6" />

                                        <ItemsControl x:Name="IcIncomingErrors" MaxHeight="240">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#230D24" BorderBrush="#801B4B" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding AppName}" Foreground="#FF4081" FontSize="12" FontWeight="ExtraBold" />
                                                                <TextBlock Text="{Binding Timestamp}" Foreground="#A67695" FontSize="10.5" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF0F6" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,2" />
                                                            <TextBlock Text="{Binding ErrorSource, StringFormat='Kaynak: {0}'}" Foreground="#FF94C8" FontSize="10.5" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- ==================== VIEW 7: DEVELOPER STUDIO & ADMIN DASHBOARD ==================== -->
                        <Grid x:Name="ViewPublisherAndSettings" Visibility="Collapsed" Margin="22,18,22,22">
                            <Grid.RowDefinitions>
                                <!-- Top Dev Studio Header & Sub-Navigation Tabs -->
                                <RowDefinition Height="Auto" />
                                <!-- Dynamic Sub-View Content -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- DEV HEADER & SUB-NAV BAR -->
                            <Border Grid.Row="0"
                                    Background="#1A0D28"
                                    BorderBrush="#FF2E93"
                                    BorderThickness="1.2"
                                    CornerRadius="14"
                                    Padding="16,12"
                                    Margin="0,0,0,16">
                                <WrapPanel VerticalAlignment="Center">
                                    <Button x:Name="BtnDevSubTabUsers"
                                            Content="👥 Kullanıcı &amp; Whitelist Masası"
                                            Style="{StaticResource PinkPrimaryButtonStyle}"
                                            Padding="14,8"
                                            FontSize="12"
                                            Margin="0,0,8,6"
                                            Click="BtnDevSubTabUsers_Click" />

                                    <Button x:Name="BtnDevSubTabTelemetry"
                                            Content="📡 Canlı Telemetri &amp; Loglar"
                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                            Padding="14,8"
                                            FontSize="12"
                                            Margin="0,0,8,6"
                                            Click="BtnDevSubTabTelemetry_Click" />

                                    <Button x:Name="BtnDevSubTabPublisher"
                                            Content="🚀 Uygulama Yayınla"
                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                            Padding="14,8"
                                            FontSize="12"
                                            Margin="0,0,8,6"
                                            Click="BtnDevSubTabPublisher_Click" />

                                                                        <Button x:Name="BtnDevSubTabSettings"
                                            Content="⚙ Bulut &amp; İstemci Ayarları"
                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                            Padding="14,8"
                                            FontSize="12"
                                            Margin="0,0,14,6"
                                            Click="BtnDevSubTabSettings_Click" />

                                    <Border Background="#331442" BorderBrush="#FF2E93" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#00E676" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="GELİŞTİRİCİ MODU: AKTİF" Foreground="#00E676" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="BtnDevLockMode"
                                            Content="🔒 Kullanıcı Moduna Geç"
                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                            Padding="12,6"
                                            FontSize="11.5"
                                            Margin="0,0,0,6"
                                            Click="BtnDevLockMode_Click"
                                            ToolTip="Geliştirici modunu geçici olarak kapatıp normal kullanıcı görünümünü test etmenizi sağlar." />
                                </WrapPanel>
                            </Border>

                            <!-- ==================== SUB-VIEW 0: USERS & WHITELIST MANAGEMENT ==================== -->
                            <Grid x:Name="DevSubViewUsers" Grid.Row="1" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <!-- Top Toolbar -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Two-column Body -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Top Toolbar -->
                                <Border Grid.Row="0"
                                        Background="#160B22"
                                        BorderBrush="#3E1E4E"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,10"
                                        Margin="0,0,0,12">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnDevRefreshUsers"
                                                    Content="🔄 Listeyi Yenile"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="12,6"
                                                    FontSize="11.5"
                                                    Margin="0,0,8,0"
                                                    Click="BtnDevRefreshUsers_Click" />

                                            <Button x:Name="BtnDevImportLegacyAlpNet"
                                                    Content="📥 Eski AlpNet Kullanıcılarını Aktar"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="12,6"
                                                    FontSize="11.5"
                                                    Click="BtnDevImportLegacyAlpNet_Click"
                                                    ToolTip="Firebase /users/ altındaki eski AlpNet cihazlarını kullanıcı tablosuna otomatik geçirir." />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Search Box -->
                                            <Border Background="#0E0517" BorderBrush="#FF2E93" BorderThickness="1" CornerRadius="8" Padding="8,4" Width="260" Margin="0,0,14,0">
                                                <DockPanel>
                                                    <TextBlock Text="🔍" Foreground="#FF85C0" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBox x:Name="TxtSearchUsers"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="#FFFFFF"
                                                             FontSize="12"
                                                             VerticalAlignment="Center"
                                                             TextChanged="TxtSearchUsers_TextChanged" />
                                                </DockPanel>
                                            </Border>

                                            <!-- Users Count Badge -->
                                            <Border Background="#331442" BorderBrush="#7A2866" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="KAYITLI KULLANICI: " Foreground="#A97E9C" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtDevTotalUsersCount" Text="0" Foreground="#00E5FF" FontSize="11.5" FontWeight="ExtraBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Two Columns: Left List, Right Detail & Permissions -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <!-- Left: Users List -->
                                        <ColumnDefinition Width="380" />
                                        <!-- Divider -->
                                        <ColumnDefinition Width="14" />
                                        <!-- Right: User Permissions & Alias Card -->
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT: USERS LIST -->
                                    <Border Grid.Column="0"
                                            Background="#160B22"
                                            BorderBrush="#3E1E4E"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="12,12">
                                        <DockPanel LastChildFill="True">
                                            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                                                <TextBlock Text="KULLANICI LİSTESİ (En Son Girenler En Üstte)" Foreground="#A97E9C" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <ListBox x:Name="LstAdminUsers"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     SelectionChanged="LstAdminUsers_SelectionChanged"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,3" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="UserBorder"
                                                                            Background="#1C0E2B"
                                                                            BorderBrush="#331442"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Padding="8,5">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="UserBorder" Property="Background" Value="#29133D" />
                                                                            <Setter TargetName="UserBorder" Property="BorderBrush" Value="#7A2866" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="UserBorder" Property="Background" Value="#381549" />
                                                                            <Setter TargetName="UserBorder" Property="BorderBrush" Value="#FF2E93" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel LastChildFill="True">
                                                            <!-- Avatar Circle -->
                                                            <Border DockPanel.Dock="Left"
                                                                    Width="32" Height="32"
                                                                    CornerRadius="16"
                                                                    Background="#FF2E93"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding InitialLetter}"
                                                                           Foreground="#FFFFFF"
                                                                           FontSize="13"
                                                                           FontWeight="ExtraBold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Right: WARP Status Badge (Only WARP status visible on unselected card) -->
                                                            <Border DockPanel.Dock="Right"
                                                                    Background="#122030"
                                                                    BorderBrush="{Binding WarpStatusBadgeColorHex}"
                                                                    BorderThickness="0.9"
                                                                    CornerRadius="6"
                                                                    Padding="7,3"
                                                                    Margin="6,0,2,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding WarpStatusBadge}"
                                                                           Foreground="{Binding WarpStatusBadgeColorHex}"
                                                                           FontSize="9"
                                                                           FontWeight="Bold" />
                                                            </Border>

                                                            <!-- Center User Info: Name, Status Dot, Admin Crown, Presence & Last Seen -->
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Ellipse Width="8" Height="8"
                                                                             Fill="{Binding PresenceDotColorHex}"
                                                                             Margin="0,0,6,0"
                                                                             VerticalAlignment="Center"
                                                                             ToolTip="{Binding PresenceStatusText}" />
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               Foreground="#FFFFFF"
                                                                               FontSize="12.5"
                                                                               FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               MaxWidth="150" />
                                                                    <Border Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                                                            Background="#FFD700"
                                                                            CornerRadius="4"
                                                                            Padding="4,1"
                                                                            Margin="6,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="👑 ADMİN"
                                                                                   Foreground="#12071C"
                                                                                   FontSize="8"
                                                                                   FontWeight="ExtraBold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PresenceStatusText}"
                                                                               Foreground="{Binding PresenceDotColorHex}"
                                                                               FontSize="9.5"
                                                                               FontWeight="SemiBold"
                                                                               Margin="0,0,8,0" />
                                                                    <TextBlock Text="🕒 "
                                                                               Foreground="#A97E9C"
                                                                               FontSize="9.5" />
                                                                    <TextBlock Text="{Binding LastSeenDisplay}"
                                                                               Foreground="#D9B6CD"
                                                                               FontSize="9.5"
                                                                               FontWeight="Medium" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>

                                    <!-- RIGHT: USER DETAILS & PERMISSION DESK -->
                                    <Border Grid.Column="2"
                                            Background="#160B22"
                                            BorderBrush="#3E1E4E"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="16,16">
                                        <Grid>
                                            <!-- Placeholder when no user selected -->
                                            <StackPanel x:Name="PnlNoUserSelected" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                                <TextBlock Text="👈" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                                <TextBlock Text="Kullanıcı Seçilmedi" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="Yetkilendirmek veya düzenlemek için soldaki listeden bir kullanıcı seçin." Foreground="#A97E9C" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- Selected User Details Card -->
                                            <ScrollViewer x:Name="PnlSelectedUserDetails" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <!-- User Header Card -->
                                                    <Border Background="#1E0E30" BorderBrush="#FF2E93" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                                        <DockPanel LastChildFill="True">
                                                            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24" Background="#FF2E93" Margin="0,0,14,0" VerticalAlignment="Center">
                                                                <TextBlock x:Name="TxtDevUserAvatar" Text="A" Foreground="#FFFFFF" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                <Button x:Name="BtnDevToggleAdminRole"
                                                                        Content="👑 Yönetici (Admin) Yap"
                                                                        Style="{StaticResource PinkPrimaryButtonStyle}"
                                                                        Padding="14,6"
                                                                        FontSize="11.5"
                                                                        Margin="0,0,0,6"
                                                                        Click="BtnDevToggleAdminRole_Click"
                                                                        ToolTip="Seçili kullanıcıya tam yönetici (admin) rolü verir veya geri alır." />

                                                                <Button x:Name="BtnStartLiveSupport"
                                                                        Content="💻 Canlı Destek (AlpDestek)"
                                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                                        Padding="14,6"
                                                                        FontSize="11.5"
                                                                        Click="BtnStartLiveSupport_Click"
                                                                        ToolTip="Bu kullanıcının bilgisayarına canlı bağlanmak için AlpDestek oturumu başlatır." />
                                                            </StackPanel>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse x:Name="DotDevUserPresence" Width="9" Height="9" Fill="#00E676" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtDevUserTitle" Text="Ahmet" Foreground="#FFFFFF" FontSize="17" FontWeight="ExtraBold" />
                                                                    <TextBlock x:Name="TxtDevUserPresenceStatus" Text="(Çevrimiçi)" Foreground="#00E676" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock x:Name="TxtDevUserActivity" Text="⚡ AlpLingo Açık (42 dk)" Foreground="#00E5FF" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="Kayıt: " Foreground="#A97E9C" FontSize="11" />
                                                                    <TextBlock x:Name="TxtDevUserRegDate" Text="18.10.2026 18:27" Foreground="#D9B6CD" FontSize="11" Margin="0,0,12,0" />
                                                                    <TextBlock Text="Son Görülme: " Foreground="#A97E9C" FontSize="11" />
                                                                    <TextBlock x:Name="TxtDevUserLastSeen" Text="Şimdi aktif" Foreground="#00E676" FontSize="11" FontWeight="Bold" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="TxtDevUserWarpStatus" Text="WARP: Kapalı" Foreground="#7E5676" FontSize="11" FontWeight="Bold" />
                                                                </StackPanel>
                                                                <TextBlock x:Name="TxtDevUserHwid" Text="AT-B495-E9F5-8F0F-1234" Foreground="#7E5676" FontSize="10.5" FontFamily="Consolas" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>

                                                    <!-- Admin Takma İsim / Not (Alias) Section -->
                                                    <Border Background="#12071C" BorderBrush="#3D1D4D" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                                        <StackPanel>
                                                            <TextBlock Text="📝 Admin Takma İsim / Not (Sadece Size Görünür):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                                            <DockPanel>
                                                                <Button x:Name="BtnSaveUserAlias"
                                                                        Content="💾 Kaydet"
                                                                        DockPanel.Dock="Right"
                                                                        Style="{StaticResource PinkPrimaryButtonStyle}"
                                                                        Padding="14,6"
                                                                        FontSize="12"
                                                                        Margin="8,0,0,0"
                                                                        Click="BtnSaveUserAlias_Click" />
                                                                <TextBox x:Name="TxtDevUserAliasInput"
                                                                         Style="{StaticResource PinkTextBoxStyle}"
                                                                         Height="36"
                                                                         FontSize="12.5" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- APPLICATION WHITELIST DESK -->
                                                    <Border Background="#12071C" BorderBrush="#3D1D4D" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,4,0,12">
                                                        <DockPanel LastChildFill="True">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button x:Name="BtnGrantAllApps"
                                                                        Content="⚡ Tümüne Yetki Ver (Süresiz)"
                                                                        Style="{StaticResource PinkPrimaryButtonStyle}"
                                                                        Padding="12,6"
                                                                        FontSize="11.5"
                                                                        Margin="0,0,8,0"
                                                                        Click="BtnGrantAllApps_Click"
                                                                        ToolTip="Kullanıcıya kurulu ve katalogdaki tüm uygulamalar için süresiz yetki tanımlar." />

                                                                <Button x:Name="BtnRevokeAllApps"
                                                                        Content="⛔ Tüm Yetkileri Kaldır"
                                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                                        Padding="12,6"
                                                                        FontSize="11.5"
                                                                        Click="BtnRevokeAllApps_Click"
                                                                        ToolTip="Kullanıcının tüm uygulamalara olan erişimini tek tıkla kapatır." />
                                                            </StackPanel>

                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="⚡ UYGULAMA YETKİLENDİRME (WHITELIST) MASASI" Foreground="#FF2E93" FontSize="12.5" FontWeight="ExtraBold" />
                                                                <TextBlock Text="Katalogdaki ve ekosistemdeki tüm uygulamalara dinamik erişim verin veya süreyi yönetin." Foreground="#A97E9C" FontSize="10.5" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>

                                                    <!-- Dynamic Whitelist Apps List -->
                                                    <ItemsControl x:Name="IcUserWhitelistApps">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#1A0D28" BorderBrush="{Binding AccentColorHex}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <DockPanel Grid.Row="0">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Border Width="26" Height="26" CornerRadius="6" Background="#16081F" BorderBrush="{Binding AccentColorHex}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
                                                                                    <Image Source="{Binding IconPackUri}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding AppName}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding Subtitle, StringFormat=' ({0})'}" Foreground="#C48FB3" FontSize="11.5" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                            </StackPanel>
                                                                            <Border Background="#26000000" BorderBrush="{Binding StatusColorHex}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                                                <TextBlock Text="{Binding StatusBadge}" Foreground="{Binding StatusColorHex}" FontSize="10.5" FontWeight="Bold" />
                                                                            </Border>
                                                                        </DockPanel>

                                                                        <TextBlock Text="{Binding StatusDescription}" Grid.Row="1" Foreground="#BCA4B7" FontSize="11" Margin="0,6,0,10" />

                                                                        <DockPanel Grid.Row="2">
                                                                            <Button Content="⛔ Yetkiyi Kaldır"
                                                                                    Tag="{Binding}"
                                                                                    DockPanel.Dock="Right"
                                                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                                                    Padding="12,6"
                                                                                    FontSize="11.5"
                                                                                    Margin="8,0,0,0"
                                                                                    Click="BtnWhitelistItemRevoke_Click"
                                                                                    ToolTip="Kullanıcıyı veritabanından silmez! Sadece bu uygulamanın yetkisini kapatır." />

                                                                            <Button Content="⚡ Yetki Ver / Uzat"
                                                                                    Tag="{Binding}"
                                                                                    DockPanel.Dock="Right"
                                                                                    Style="{StaticResource PinkPrimaryButtonStyle}"
                                                                                    Padding="12,6"
                                                                                    FontSize="11.5"
                                                                                    Margin="8,0,0,0"
                                                                                    Click="BtnWhitelistItemGrant_Click" />

                                                                            <ComboBox SelectedIndex="{Binding SelectedDurationIndex, Mode=TwoWay}"
                                                                                      Width="150"
                                                                                      Height="32"
                                                                                      Background="#12071C"
                                                                                      Foreground="#FFFFFF"
                                                                                      BorderBrush="#7A2866">
                                                                                <ComboBoxItem Content="1 Gün" Tag="1" />
                                                                                <ComboBoxItem Content="7 Gün (1 Hafta)" Tag="7" />
                                                                                <ComboBoxItem Content="30 Gün (1 Ay)" Tag="30" />
                                                                                <ComboBoxItem Content="90 Gün (3 Ay)" Tag="90" />
                                                                                <ComboBoxItem Content="365 Gün (1 Yıl)" Tag="365" />
                                                                                <ComboBoxItem Content="Süresiz (Sınırsız)" Tag="99999" />
                                                                            </ComboBox>
                                                                        </DockPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- DANGER ZONE: DELETE USER COMPLETELY -->
                                                    <Border Background="#26FF1744" BorderBrush="#80FF1744" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                        <DockPanel LastChildFill="True">
                                                            <Button x:Name="BtnDeleteUserRecord"
                                                                    Content="🗑 Kullanıcıyı Tamamen Sil"
                                                                    DockPanel.Dock="Right"
                                                                    Background="#FF1744"
                                                                    Foreground="#FFFFFF"
                                                                    FontWeight="Bold"
                                                                    Padding="14,8"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand"
                                                                    Click="BtnDeleteUserRecord_Click" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Kullanıcıyı Veritabanından Sil:" Foreground="#FF8A80" FontSize="11.5" FontWeight="Bold" />
                                                                <TextBlock Text="Kullanıcının kaydını ve tüm uygulama yetkilerini Firebase'den tamamen siler." Foreground="#D19EA9" FontSize="10" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- ==================== SUB-VIEW 1: LIVE TELEMETRY & USER LOGS ==================== -->
                            <Grid x:Name="DevSubViewTelemetry" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 1. Metric Stat Cards -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Total Events -->
                                    <Border Grid.Column="0" Background="#160B22" BorderBrush="#3E1E4E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="TOPLAM KULLANICI OLAYI" Foreground="#A97E9C" FontSize="10.5" FontWeight="Bold" />
                                            <TextBlock x:Name="TxtDevStatTotalEvents" Text="0 Olay" Foreground="#FFFFFF" FontSize="20" FontWeight="ExtraBold" Margin="0,3,0,0" />
                                            <TextBlock Text="Canlı Firebase Akışı" Foreground="#FF5CAA" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Downloads -->
                                    <Border Grid.Column="1" Background="#160B22" BorderBrush="#3E1E4E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="İNDİRMELER &amp; KURULUMLAR" Foreground="#A97E9C" FontSize="10.5" FontWeight="Bold" />
                                            <TextBlock x:Name="TxtDevStatDownloads" Text="0 İndirme" Foreground="#00E5FF" FontSize="20" FontWeight="ExtraBold" Margin="0,3,0,0" />
                                            <TextBlock Text="Kullanıcı Uygulama İndirmeleri" Foreground="#00E5FF" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Errors & Crashes -->
                                    <Border Grid.Column="2" Background="#160B22" BorderBrush="#3E1E4E" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="HATALAR &amp; ÇÖKMELER" Foreground="#A97E9C" FontSize="10.5" FontWeight="Bold" />
                                            <TextBlock x:Name="TxtDevStatErrors" Text="0 Hata" Foreground="#FF1744" FontSize="20" FontWeight="ExtraBold" Margin="0,3,0,0" />
                                            <TextBlock Text="Anında Otomatik Bildirilen" Foreground="#FF1744" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Unique Devices -->
                                    <Border Grid.Column="3" Background="#160B22" BorderBrush="#3E1E4E" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="AKTİF KULLANICI CİHAZLARI" Foreground="#A97E9C" FontSize="10.5" FontWeight="Bold" />
                                            <TextBlock x:Name="TxtDevStatDevices" Text="0 Cihaz" Foreground="#00E676" FontSize="20" FontWeight="ExtraBold" Margin="0,3,0,0" />
                                            <TextBlock Text="Benzersiz Alp HWID" Foreground="#00E676" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 2. Filter Bar & Search -->
                                <Border Grid.Row="1" Background="#140920" BorderBrush="#3B1C4B" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnDevClearOldLogs"
                                                    Content="🧹 Eskileri Temizle"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="12,7"
                                                    FontSize="12"
                                                    Margin="0,0,8,0"
                                                    Click="BtnDevClearOldLogs_Click"
                                                    ToolTip="Buluttaki eski telemetri olaylarını ve hata kayıtlarını temizler." />
                                            <Button x:Name="BtnRefreshDevEvents"
                                                    Content="🔄 Canlı Verileri Yenile"
                                                    Style="{StaticResource PinkPrimaryButtonStyle}"
                                                    Padding="14,7"
                                                    FontSize="12"
                                                    Click="BtnRefreshDevEvents_Click" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Filtrele:" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button x:Name="BtnDevFilterAll" Content="Tümü" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnDevFilterAll_Click" />
                                            <Button x:Name="BtnDevFilterDownloads" Content="⬇ İndirmeler" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnDevFilterDownloads_Click" />
                                            <Button x:Name="BtnDevFilterInstalls" Content="✔ Kurulumlar" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnDevFilterInstalls_Click" />
                                            <Button x:Name="BtnDevFilterLaunches" Content="▶ Başlatmalar" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnDevFilterLaunches_Click" />
                                            <Button x:Name="BtnDevFilterErrors" Content="🚨 Hatalar &amp; Çökmeler" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,0,12,0" Click="BtnDevFilterErrors_Click" />

                                            <TextBlock Text="👤 Kişi:" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox x:Name="CmbDevFilterUser"
                                                      Width="160"
                                                      Height="30"
                                                      Background="#12071C"
                                                      Foreground="#FFFFFF"
                                                      BorderBrush="#7A2866"
                                                      Margin="0,0,10,0"
                                                      SelectionChanged="CmbDevFilterUser_SelectionChanged" />

                                            <TextBox x:Name="TxtDevSearch"
                                                     Style="{StaticResource PinkTextBoxStyle}"
                                                     Width="180"
                                                     Padding="10,6"
                                                     FontSize="11.5"
                                                     TextChanged="TxtDevSearch_TextChanged"
                                                     ToolTip="Cihaz ID, uygulama adı veya hata detayı arayın" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- 3. Event List & Detail Inspector Split -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Telemetry Event Stream -->
                                    <Border Grid.Column="0" Background="#12081B" BorderBrush="#351744" BorderThickness="1" CornerRadius="14" Margin="0,0,12,0" Padding="10">
                                        <ListBox x:Name="LstDevTelemetryEvents"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="LstDevTelemetryEvents_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,6" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="ItemBorder" Background="#180C25" BorderBrush="#3E1E4F" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#251338" />
                                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF5CAA" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#2E1644" />
                                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF2E93" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <DockPanel Grid.Row="0">
                                                            <Border Background="{Binding EventColorHex}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding EventBadgeText}" Foreground="#000000" FontSize="9.5" FontWeight="ExtraBold" />
                                                            </Border>
                                                            <TextBlock Text="{Binding AppName}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" Foreground="#FF85C0" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Timestamp}" Foreground="#8E6384" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </DockPanel>

                                                        <TextBlock Grid.Row="1" Text="{Binding Details}" Foreground="#FFEAF5" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,3" />

                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="Cihaz: " Foreground="#8E6384" FontSize="10.5" />
                                                            <TextBlock Text="{Binding DeviceId}" Foreground="#00E5FF" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                            <TextBlock Text="PC: " Foreground="#8E6384" FontSize="10.5" />
                                                            <TextBlock Text="{Binding MachineName}" Foreground="#FF94C8" FontSize="10.5" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding UserName}" Foreground="#C4A8BC" FontSize="10.5" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <!-- Right: Selected Event Deep Inspector -->
                                    <Border Grid.Column="1" Background="#140920" BorderBrush="#3B1C4B" BorderThickness="1" CornerRadius="14" Padding="16,14">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,10">
                                                    <TextBlock Text="🔍 Olay / Hata Detay İnceleyici" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <Button x:Name="BtnDevCopySelectedEvent"
                                                            Content="📋 Kopyala"
                                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                                            Padding="8,4"
                                                            FontSize="11"
                                                            HorizontalAlignment="Right"
                                                            Click="BtnDevCopySelectedEvent_Click" />
                                                </DockPanel>

                                                <TextBlock Text="Olay Kimliği (ID):" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" />
                                                <TextBox x:Name="TxtDevDetailEventId" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,8" FontSize="11.5" />

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Zaman Damgası:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" />
                                                        <TextBox x:Name="TxtDevDetailTime" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,0" FontSize="11.5" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="Olay Türü:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" />
                                                        <TextBox x:Name="TxtDevDetailType" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,0" FontSize="11.5" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Uygulama:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" />
                                                        <TextBox x:Name="TxtDevDetailApp" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,0" FontSize="11.5" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="Sürüm:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" />
                                                        <TextBox x:Name="TxtDevDetailVersion" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,0" FontSize="11.5" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Kullanıcı Cihaz ID (HWID):" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" />
                                                <TextBox x:Name="TxtDevDetailDeviceId" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,8" FontSize="11.5" />

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Bilgisayar Adı:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" />
                                                        <TextBox x:Name="TxtDevDetailMachine" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,0" FontSize="11.5" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="Kullanıcı Adı:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" />
                                                        <TextBox x:Name="TxtDevDetailUser" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,0" FontSize="11.5" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Açıklama &amp; Mesaj:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" />
                                                <TextBox x:Name="TxtDevDetailMessage" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,8" FontSize="11.5" Height="60" TextWrapping="Wrap" AcceptsReturn="True" />

                                                <TextBlock Text="Hata İzi / Yığın / Log Kayıtları (Stack Trace):" Foreground="#FF1744" FontSize="10.5" FontWeight="Bold" />
                                                <TextBox x:Name="TxtDevDetailStackTrace" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" Margin="0,2,0,0" FontSize="10.5" FontFamily="Consolas" Height="140" TextWrapping="Wrap" AcceptsReturn="True" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- ==================== SUB-VIEW 2: APP PUBLISHER ==================== -->
                            <ScrollViewer x:Name="DevSubViewPublisher" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <Border Background="{StaticResource PinkHeroBackdropBrush}"
                                        BorderBrush="#FF2E93"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        Padding="24,20"
                                        Margin="0,0,0,10">
                                    <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                                        <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                                            <TextBlock Text="GELİŞTİRİCİ YAYINLAMA STÜDYOSU" Foreground="#FFFFFF" FontSize="10.5" FontWeight="ExtraBold" />
                                        </Border>

                                        <TextBlock Text="🚀 Yeni Uygulama veya Yeni Sürüm Yayınla"
                                                   Foreground="#FFFFFF"
                                                   FontSize="21"
                                                   FontWeight="ExtraBold"
                                                   Margin="0,0,0,4" />
                                        <!-- Fast App Selector Dropdown -->
                                        <Border Background="#1D0C2C" BorderBrush="#FF2E93" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="🎯 Hızlı Uygulama Seçici (Kayıtlı Yollar, Sürümler &amp; Şablonlar):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,6" />
                                                <ComboBox x:Name="CmbPubAppSelector"
                                                          Background="#140A20"
                                                          Foreground="#FFEAF5"
                                                          BorderBrush="#7A2866"
                                                          Padding="8,6"
                                                          SelectionChanged="CmbPubAppSelector_SelectionChanged">
                                                    <ComboBoxItem Content="🔌 AlpNet Pulse (Ağ, WARP &amp; Sesli Çeviri)" Tag="alpnet" />
                                                    <ComboBoxItem Content="✦ AlpLingo (AI Oyun İçi Çeviri &amp; OCR)" Tag="alplingo" />
                                                    <ComboBoxItem Content="🤖 AlphaGravity (Çoklu Model AI Asistanı)" Tag="alphagravity" />
                                                    <ComboBoxItem Content="📈 AlpFinans (Borsa, Kripto &amp; Portföy)" Tag="alpfinans" />
                                                    <ComboBoxItem Content="🦀 AlpRust+ (Rust+ Cihaz, Kamera &amp; Raid Alarmı)" Tag="alprust-plus" />
                                                    <ComboBoxItem Content="⚙ [Özel / Yeni Uygulama]" Tag="custom" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="📁 Hazır Derleme / Yerel .exe Dosya Yolu (Otomatik Tanınır):" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubLocalPath" Style="{StaticResource PinkTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                                <Button Content="📂 Dosya Seç" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="14,8" Click="BtnPickLocalExeForPublish_Click" ToolTip="Bilgisayarınızdaki derlenmiş .exe dosyasını seçer." />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Uygulama Adı (Örn: AlpStudio Pro):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubAppName" Style="{StaticResource PinkTextBoxStyle}" Text="AlpStudio Pro" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                <TextBlock Text="Yeni Sürüm:" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubVersion" Style="{StaticResource PinkTextBoxStyle}" Text="1.0.0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                <TextBlock Text="Kategori:" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubCategory" Style="{StaticResource PinkTextBoxStyle}" Text="Sistem &amp; Araçlar" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Ana Çalıştırılabilir .exe Adı (Örn: AlpStudio.exe):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubExeName" Style="{StaticResource PinkTextBoxStyle}" Text="AlpStudio.exe" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Varsayılan Alt Klasör &amp; Boyut (Örn: 48.5 MB):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtPubSizeText" Style="{StaticResource PinkTextBoxStyle}" Text="48.5 MB" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Doğrudan Paket İndirme Linki (GitHub Release .exe veya .zip URL):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPubDirectUrl" Style="{StaticResource PinkTextBoxStyle}" Text="https://github.com/alphankilicaslan/AlpTogether/releases/download/v1.0/AlpStudio.exe" Margin="0,0,0,10" />

                                        <TextBlock Text="Varsa Kendi Kurulum Aracı (Hibrit Setup.exe / MSI URL - Opsiyonel):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPubInstallerUrl" Style="{StaticResource PinkTextBoxStyle}" Text="" Margin="0,0,0,10" />

                                        <TextBlock Text="Kısa Açıklama:" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPubDescription" Style="{StaticResource PinkTextBoxStyle}" Height="56" TextWrapping="Wrap" AcceptsReturn="True" Text="AlpTogether ekosistemi için geliştirilmiş yeni nesil yüksek performanslı masaüstü uygulaması." Margin="0,0,0,10" />

                                        <TextBlock Text="Son Yenilikler / Yama Notları (Her satır bir madde olarak görünür):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPubPatchNotes" Style="{StaticResource PinkTextBoxStyle}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" Text="İlk kararlı sürüm yayınlandı.&#x0a;Hibrit güncelleme ve otomatik onarım desteği eklendi." Margin="0,0,0,10" />

                                        <TextBlock Text="🖼️ Yama / Güncelleme Görseli Yükle (İsteğe Bağlı):" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtPubPatchImage" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" />
                                            <Button x:Name="BtnPickPatchImage"
                                                    Grid.Column="1"
                                                    Content="🖼 Görsel Seç..."
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="12,6"
                                                    Margin="8,0,0,0"
                                                    Click="BtnPickPatchImage_Click" />
                                            <Button x:Name="BtnClearPatchImage"
                                                    Grid.Column="2"
                                                    Content="✕ Temizle"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="10,6"
                                                    Margin="6,0,0,0"
                                                    Click="BtnClearPatchImage_Click" />
                                        </Grid>

                                        <!-- Patch Image Preview -->
                                        <Border x:Name="BrdPatchImagePreview"
                                                Width="140" Height="90"
                                                CornerRadius="10"
                                                Background="#14081E"
                                                BorderBrush="#5E1E50"
                                                BorderThickness="1.5"
                                                ClipToBounds="True"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,14"
                                                Visibility="Collapsed">
                                            <Image x:Name="ImgPatchPreview" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <WrapPanel>
                                            <Button Content="🔥 Kataloğa Yayınla (Bulut + GitHub catalog.json)"
                                                    Style="{StaticResource PinkPrimaryButtonStyle}"
                                                    Padding="20,12"
                                                    FontSize="13.5"
                                                    Margin="0,0,10,6"
                                                    Click="BtnPublishNewApp_Click" />

                                            <Button Content="📂 Yerel .exe Seçip Bilgileri Doldur"
                                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                                    Padding="14,12"
                                                    Margin="0,0,0,6"
                                                    Click="BtnPickLocalExeForPublish_Click" />
                                        </WrapPanel>

                                        <TextBlock x:Name="TxtPublishResultStatus"
                                                   Text=""
                                                   Foreground="#00E676"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>

                            <!-- ==================== SUB-VIEW 4: SETTINGS ==================== -->
                            <ScrollViewer x:Name="DevSubViewSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <Border Background="#140A20"
                                        BorderBrush="#461F56"
                                        BorderThickness="1.2"
                                        CornerRadius="16"
                                        Padding="24,20"
                                        MaxWidth="860"
                                        HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock Text="⚙ Bulut, GitHub &amp; Telemetri Ayarları"
                                                   Foreground="#FFFFFF"
                                                   FontSize="18"
                                                   FontWeight="ExtraBold"
                                                   Margin="0,0,0,12" />

                                        <TextBlock Text="GitHub Raw Katalog Adresi (catalog.json):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSettingGitHubCatalog" Style="{StaticResource PinkTextBoxStyle}" Margin="0,0,0,12" />

                                        <TextBlock Text="Firebase Realtime Database Adresi (Canlı Katalog, Telemetri &amp; Hata Takibi):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSettingFirebaseUrl" Style="{StaticResource PinkTextBoxStyle}" Margin="0,0,0,12" />

                                        <TextBlock Text="Özel Discord / Telegram Webhook URL (Anlık İndirme &amp; Hata Bildirimi İçin):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSettingWebhookUrl" Style="{StaticResource PinkTextBoxStyle}" Margin="0,0,0,14" />

                                        <CheckBox x:Name="ChkSettingAutoTelemetry"
                                                  Content="Kullanıcı hata aldığında anında otomatik hata raporu gönder"
                                                  Foreground="#FFEAF5"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,10" />

                                        <CheckBox x:Name="ChkSettingMonitorChildCrashes"
                                                  Content="AlpTogether içinden başlatılan uygulamaların çökmelerini (Crash) izle"
                                                  Foreground="#FFEAF5"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,10" />

                                        <CheckBox x:Name="ChkSettingDesktopShortcut"
                                                  Content="Kurulum ve onarım sonrasında masaüstü kısayolu oluştur"
                                                  Foreground="#FFEAF5"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,18" />

                                        <!-- AlpTogether Client Self-Update Section -->
                                        <Border Background="#160B24" BorderBrush="#3D1D4D" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,18">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="🚀 AlpTogether Sürüm &amp; Güncelleme Sistemi" Foreground="#FF85C0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <Border Background="#2A1435" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                        <TextBlock x:Name="TxtSettingsClientVersion" Text="v1.1.1" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" />
                                                    </Border>
                                                </DockPanel>

                                                <TextBlock Text="AlpTogether GitHub Releases üzerinden kendini otomatik denetler ve tek tıkla in-place (kesintisiz) olarak günceller."
                                                           Foreground="#BCA4B7" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="16" />

                                                <DockPanel Margin="0,0,0,10">
                                                    <Button x:Name="BtnCheckClientUpdatesSettings"
                                                            Content="🔄 AlpTogether Güncellemelerini Şimdi Denetle"
                                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                                            Padding="14,7"
                                                            FontSize="11.5"
                                                            Click="BtnCheckUpdatesQuick_Click" />
                                                    <TextBlock x:Name="TxtSettingsUpdateStatus"
                                                               Text="Henüz denetlenmedi"
                                                               Foreground="#9E7696"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0" />
                                                </DockPanel>

                                                <CheckBox x:Name="ChkSettingAutoCheckUpdates"
                                                          Content="AlpTogether açılışında yeni sürümleri arka planda otomatik denetle"
                                                          Foreground="#FFEAF5"
                                                          FontSize="12"
                                                          IsChecked="True" />
                                            </StackPanel>
                                        </Border>

                                        <Button Content="💾 Tüm İstemci Ayarlarını Kaydet"
                                                Style="{StaticResource PinkPrimaryButtonStyle}"
                                                Padding="18,11"
                                                Click="BtnSaveSettings_Click" />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Grid>

                    </Grid>

                    <!-- 4. BOTTOM COLLAPSIBLE LIVE LOG & TELEMETRY STATUS BAR -->
                    <Border Grid.Row="3"
                            Background="#10071A"
                            BorderBrush="#331742"
                            BorderThickness="0,1,0,0"
                            Padding="18,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#FF2E93" Margin="0,0,8,0" />
                                <TextBlock Text="SON İŞLEM LOGU:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBottomLiveLog"
                                           Text="AlpTogether hazır."
                                           Foreground="#E6C6DA"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="720" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="▤ Özel Boşluk &amp; Log Konsolunu Aç"
                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Click="BtnNavCustomLogs_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
            <!-- ==================== DEVELOPER ADMIN UNLOCK MODAL OVERLAY ==================== -->
            <Grid x:Name="AdminUnlockOverlay"
                  Visibility="Collapsed"
                  Background="#E608040F"
                  Panel.ZIndex="2000">
                <Border Width="520"
                        Background="#190C28"
                        BorderBrush="#FF2E93"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="26,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF2E93" BlurRadius="32" ShadowDepth="0" Opacity="0.5" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Modal Title -->
                        <DockPanel Margin="0,0,0,12">
                            <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="ALPTOGETHER SECURITY" Foreground="#FFFFFF" FontSize="10" FontWeight="ExtraBold" />
                            </Border>
                            <Button Content="✕"
                                    Foreground="#C8A8C0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Right"
                                    Cursor="Hand"
                                    Click="BtnModalClose_Click" />
                        </DockPanel>

                        <TextBlock Text="🔐 Geliştirici &amp; Admin Girişi" Foreground="#FFFFFF" FontSize="20" FontWeight="ExtraBold" Margin="0,0,0,4" />
                        <TextBlock Text="Geliştirici Stüdyosu, Canlı Kullanıcı Telemetrisi ve Uygulama Yayınlama araçlarını açmak için admin anahtarınızı veya master parolanızı girin."
                                   Foreground="#D9B6CD" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="17" />

                        <!-- Device HWID -->
                        <Border Background="#12071C" BorderBrush="#3D1D4D" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Bu Cihazın AlpTogether HWID Kimliği:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Button x:Name="BtnModalCopyHwid"
                                            Content="📋 Kopyala"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                            Padding="10,5"
                                            Margin="8,0,0,0"
                                            Click="BtnModalCopyHwid_Click" />
                                    <TextBox x:Name="TxtModalDeviceHwid" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" FontWeight="Bold" Foreground="#00E5FF" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Input Key or Passcode -->
                        <TextBlock Text="Admin Lisans Anahtarı veya Geliştirici Parolası:" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtModalAdminInput"
                                 Style="{StaticResource PinkTextBoxStyle}"
                                 Height="52"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 Margin="0,0,0,8"
                                 FontSize="12" />

                        <TextBlock x:Name="TxtModalStatus" Text="" Foreground="#FF1744" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,14" TextWrapping="Wrap" />

                        <!-- Action Buttons -->
                        <DockPanel LastChildFill="False">
                            <Button Content="Vazgeç / Kapat"
                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                    Padding="16,9"
                                    Click="BtnModalClose_Click" />

                            <Button Content="🚀 Geliştirici Modunu Aç"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource PinkPrimaryButtonStyle}"
                                    Padding="20,10"
                                    Click="BtnModalUnlock_Click" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- USERNAME REGISTRATION PROMPT MODAL (1 HWID = 1 UNIQUE NAME) -->
            <Grid x:Name="ModalUsernamePrompt"
                  Visibility="Collapsed"
                  Panel.ZIndex="1000"
                  Background="#E6070310">
                <Border Width="500"
                        Background="#190C28"
                        BorderBrush="#FF2E93"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="28,26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF2E93" BlurRadius="36" ShadowDepth="0" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Modal Title -->
                        <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="ALPTOGETHER KULLANICI KAYDI" Foreground="#FFFFFF" FontSize="10" FontWeight="ExtraBold" />
                        </Border>

                        <TextBlock Text="👋 Hoş Geldiniz!" Foreground="#FFFFFF" FontSize="22" FontWeight="ExtraBold" Margin="0,0,0,4" />
                        <TextBlock Text="Lütfen kendinize bir Kullanıcı Adı / Takma Ad belirleyin:"
                                   Foreground="#D9B6CD" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18" />

                        <!-- Explanation alert box -->
                        <Border Background="#12071C" BorderBrush="#3D1D4D" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="💡 Bu Şifreli Bir Giriş Hesabı Değildir!" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,3" />
                                <TextBlock Text="Bu isim sadece yönetici (Alphan) size yetki verirken sizi listede tanıyabilmesi içindir. Belirlediğiniz isim bu cihazın HWID kimliğine kalıcı olarak bağlanır ve başka bir kullanıcı aynı ismi alamaz (1 HWID = 1 Benzersiz İsim)."
                                           Foreground="#BCA4B7" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                            </StackPanel>
                        </Border>

                        <!-- Device HWID Display -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Cihazınızın HWID Kimliği:" Foreground="#FF85C0" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,3" />
                            <TextBox x:Name="TxtPromptDeviceHwid" Style="{StaticResource PinkTextBoxStyle}" IsReadOnly="True" FontWeight="Bold" Foreground="#A97E9C" FontSize="11" />
                        </StackPanel>

                        <!-- Username Input -->
                        <TextBlock Text="Kullanıcı Adınız / Takma Adınız (Örn: ahmet, mehmet26):" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtPromptUsernameInput"
                                 Style="{StaticResource PinkTextBoxStyle}"
                                 Height="44"
                                 MaxLength="24"
                                 FontSize="14"
                                 FontWeight="Bold"
                                 Foreground="#FFFFFF"
                                 Margin="0,0,0,6"
                                 KeyDown="TxtPromptUsernameInput_KeyDown" />

                        <TextBlock x:Name="TxtPromptUsernameStatus"
                                   Text=""
                                   Foreground="#FF1744"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"
                                   TextWrapping="Wrap" />

                        <!-- Save & Start Button -->
                        <Button x:Name="BtnSaveUsernamePrompt"
                                Content="✓ Kaydet ve AlpTogether'a Başla"
                                Style="{StaticResource PinkPrimaryButtonStyle}"
                                Height="44"
                                FontSize="13.5"
                                FontWeight="Bold"
                                Click="BtnSaveUsernamePrompt_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== CLIENT SELF-UPDATE MODAL OVERLAY ==================== -->
            <Grid x:Name="ClientUpdateModalOverlay"
                  Visibility="Collapsed"
                  Background="#E608040F"
                  Panel.ZIndex="2100">
                <Border Width="560"
                        Background="#190C28"
                        BorderBrush="#FF2E93"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="28,26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF2E93" BlurRadius="36" ShadowDepth="0" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Modal Header -->
                        <DockPanel Margin="0,0,0,12">
                            <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="ALPTOGETHER SÜRÜM GÜNCELLEMESİ" Foreground="#FFFFFF" FontSize="10" FontWeight="ExtraBold" />
                            </Border>
                            <Button Content="✕"
                                    Foreground="#C8A8C0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Right"
                                    Cursor="Hand"
                                    Click="BtnCloseClientUpdateModal_Click" />
                        </DockPanel>

                        <TextBlock x:Name="TxtClientUpdateModalTitle" Text="🚀 Yeni Sürüm Hazır!" Foreground="#FFFFFF" FontSize="22" FontWeight="ExtraBold" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtClientUpdateVersionCompare"
                                   Text="Kurulu Sürüm: v1.1.1  ➜  Yeni Sürüm: v1.1.1"
                                   Foreground="#00E5FF"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12" />

                        <!-- Release notes container -->
                        <Border Background="#12071C" BorderBrush="#3D1D4D" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="📋 Yeni Sürümdeki Değişiklikler &amp; Yama Notları:" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtClientUpdateNotes"
                                               Text="Güncelleme detayları alınıyor..."
                                               Foreground="#D9B6CD"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               LineHeight="17" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Download Progress Section (Visible during download) -->
                        <StackPanel x:Name="PnlClientUpdateProgress" Visibility="Collapsed" Margin="0,0,0,14">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="TxtClientUpdateProgressStatus"
                                           Text="İndiriliyor... %0"
                                           Foreground="#FFE0F1"
                                           FontSize="11.5"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtClientUpdateProgressPercent"
                                           Text="%0"
                                           Foreground="#FF2E93"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <ProgressBar x:Name="PbClientUpdateDownload"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Foreground="#FF2E93"
                                         Background="#2A1435"
                                         BorderThickness="0" />
                        </StackPanel>

                        <!-- Status / Error text -->
                        <TextBlock x:Name="TxtClientUpdateModalStatus"
                                   Text=""
                                   Foreground="#FF1744"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <!-- Action Buttons -->
                        <DockPanel LastChildFill="False">
                            <Button x:Name="BtnClientUpdateCancel"
                                    Content="Daha Sonra"
                                    Style="{StaticResource PinkSecondaryButtonStyle}"
                                    Padding="18,9"
                                    Click="BtnCloseClientUpdateModal_Click" />

                            <Button x:Name="BtnClientUpdateExecute"
                                    Content="🚀 İndir, Güncelle ve Yeniden Başlat"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource PinkPrimaryButtonStyle}"
                                    Padding="20,10"
                                    FontWeight="Bold"
                                    Click="BtnClientUpdateExecute_Click" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
