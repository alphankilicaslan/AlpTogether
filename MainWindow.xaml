                                                                   Foreground="#FF94C8"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="TxtHeroSpeed"
