<Window x:Class="AlpTogether.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:AlpTogether.Controls"
        Title="AlpTogether — Birleşik Uygulama İstemcisi"
        Width="1340" Height="860"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="AmbientOrb1Transform"
                                     Storyboard.TargetProperty="X"
                                     From="-40" To="90" Duration="0:0:9" />
                    <DoubleAnimation Storyboard.TargetName="AmbientOrb1Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="-20" To="60" Duration="0:0:7" />
                    <DoubleAnimation Storyboard.TargetName="AmbientOrb2Transform"
                                     Storyboard.TargetProperty="X"
                                     From="40" To="-80" Duration="0:0:11" />
                    <DoubleAnimation Storyboard.TargetName="AmbientOrb2Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="30" To="-50" Duration="0:0:8" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Outer Window Frame -->
    <Border x:Name="OuterWindowBorder"
            Background="{StaticResource BgDeepBrush}"
            BorderBrush="#4A1D56"
            BorderThickness="1.5"
            CornerRadius="16"
            ClipToBounds="True">

        <Grid>
            <!-- Animated Pink / Rose Ambient Glow Orbs -->
            <Canvas IsHitTestVisible="False" Opacity="0.42">
                <Ellipse Width="520" Height="520" Canvas.Left="-120" Canvas.Top="-140">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="AmbientOrb1Transform" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55FF2E93" Offset="0" />
                            <GradientStop Color="#22D81B60" Offset="0.5" />
                            <GradientStop Color="#0009050E" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="620" Height="620" Canvas.Right="-160" Canvas.Bottom="-180">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="AmbientOrb2Transform" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#44FF5CAA" Offset="0" />
                            <GradientStop Color="#189C27B0" Offset="0.55" />
                            <GradientStop Color="#0009050E" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left Navigation & Quick App Rail -->
                    <ColumnDefinition x:Name="SidebarColumn" Width="265" />
                    <!-- Main Content Area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT SIDEBAR ==================== -->
                <Border Grid.Column="0"
                        Background="#11081B"
                        BorderBrush="#331742"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Brand Header with Pink Logo -->
                        <Border x:Name="PnlBrandLogoContainer" Grid.Row="0" Padding="18,18,18,14" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="BrBrandLogo"
                                        Width="48" Height="48"
                                        CornerRadius="12"
                                        BorderBrush="#FF5CAA"
                                        BorderThickness="1.5"
                                        Cursor="Hand"
                                        ToolTip="Geliştirici Girişi: 5 kez tıklayın (veya Ctrl+Shift+D)"
                                        MouseLeftButtonDown="BrandLogo_MouseLeftButtonDown">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF2E93" BlurRadius="18" ShadowDepth="0" Opacity="0.65" />
                                    </Border.Effect>
                                    <Image Source="pack://application:,,,/Assets/alptogether_logo_pink.png"
                                           Stretch="Uniform"
                                           Margin="3"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel x:Name="PnlBrandText" Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Alp" Foreground="#FFFFFF" FontSize="20" FontWeight="ExtraBold" />
                                        <TextBlock Text="Together" Foreground="#FF3D9A" FontSize="20" FontWeight="ExtraBold" />
                                    </StackPanel>
                                    <TextBlock Text="UNIFIED ECOSYSTEM CLIENT"
                                               Foreground="#B987AD"
                                               FontSize="9.5"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Navigation Menu -->
                        <StackPanel x:Name="PnlNavMenuSection" Grid.Row="1" Margin="12,4,12,8">
                            <TextBlock x:Name="TxtNavHeaderMenu" Text="ANA MENÜ" Foreground="#8E6384" FontSize="10.5" FontWeight="Bold" Margin="10,4,0,6" />

                            <Button x:Name="BtnNavStore"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    ToolTip="❖ Kütüphane &amp; Keşfet"
                                    Click="BtnNavStore_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❖" Foreground="#FF2E93" FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavStore" Text="Kütüphane &amp; Keşfet" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavDownloads"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    ToolTip="⬇ İndirmeler &amp; Güncellemeler"
                                    Click="BtnNavDownloads_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬇" Foreground="#FF5CAA" FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavDownloads" Text="İndirme" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavChangelog"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    ToolTip="✦ Son Yenilikler (Yama Notu)"
                                    Click="BtnNavChangelog_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✦" Foreground="#FF85C0" FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavChangelog" Text="Son Yenilikler (Yama Notu)" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavRepair"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    ToolTip="🛠 Onarım &amp; Dosya Yolu"
                                    Click="BtnNavRepair_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠" Foreground="#FF4081" FontSize="14" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavRepair" Text="Onarım &amp; Dosya Yolu" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavCustomLogs"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    ToolTip="▤ Özel Boşluk &amp; Canlı Log"
                                    Click="BtnNavCustomLogs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▤" Foreground="#FF66B2" FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavCustomLogs" Text="Özel Boşluk &amp; Canlı Log" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavHelp"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    ToolTip="💬 Yardım &amp; Sorun Bildir"
                                    Click="BtnNavHelp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💬" Foreground="#FF2E93" FontSize="14" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNavHelp" Text="Yardım &amp; Sorun Bildir" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavDevStudio"
                                    Visibility="Collapsed"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    ToolTip="⚡ Geliştirici Stüdyosu &amp; Whitelist Masası"
                                    Click="BtnNavDevStudio_Click">
                                <DockPanel LastChildFill="True">
                                    <Border x:Name="BrdNavDevStudioBadge" DockPanel.Dock="Right" Background="#FF2E93" CornerRadius="4" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ADMIN" Foreground="#FFFFFF" FontSize="8.5" FontWeight="ExtraBold" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" Foreground="#FF2E93" FontSize="14" Width="24" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtNavDevStudio" Text="Geliştirici Stüdyosu" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </StackPanel>

                        <!-- Riot/Steam Style Quick App Switcher List -->
                        <Grid x:Name="PnlQuickAppsSection" Grid.Row="2" Margin="12,4,12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="10,4,6,8">
                                <TextBlock Text="HIZLI UYGULAMA GEÇİŞİ" Foreground="#8E6384" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtSidebarAppCount" Text="6" Foreground="#FF5CAA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            </DockPanel>

                            <ListBox x:Name="LstQuickApps"
                                     Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="LstQuickApps_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="#180D26"
                                                            BorderBrush="#2E1640"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="9,8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#251339" />
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#7A2866" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#31133E" />
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF2E93" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="7" ClipToBounds="True" BorderBrush="#55FF5CAA" BorderThickness="1">
                                                <Image Source="{Binding IconPackUri}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#FFF2F9" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StateBadgeText}" Foreground="#C48FB3" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" Background="#2A1238" CornerRadius="6" Padding="6,2" BorderBrush="#592252" BorderThickness="1">
                                                <TextBlock Text="{Binding LatestVersion, StringFormat=v{0}}" Foreground="#FF85C0" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Sidebar Footer: Telemetry & GitHub Status -->
                        <Border x:Name="PnlSidebarFooter" Grid.Row="3"
                                Margin="12,0,12,12"
                                Padding="12,10"
                                CornerRadius="12"
                                Background="#190C26"
                                BorderBrush="#441E4E"
                                BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#00E676" Margin="0,0,7,0" />
                                        <TextBlock Text="Anlık Telemetri &amp; Bulut Aktif" Foreground="#FFD4EB" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="TxtDeviceIdFooter"
                                           Text="Cihaz ID: ALP-..."
                                           Foreground="#9C7391"
                                           FontSize="10"
                                           Margin="0,4,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtSidebarClientVersion" Text="AlpTogether v1.1.1" Foreground="#B987AD" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Content="🔄 Denetle"
                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                            Padding="6,2"
                                            FontSize="9.5"
                                            Margin="8,0,0,0"
                                            Click="BtnCheckUpdatesQuick_Click"
                                            ToolTip="AlpTogether güncellemelerini GitHub üzerinden denetle" />
                                </StackPanel>
                                <Border x:Name="BrdSidebarUpdateBadge"
                                        Visibility="Collapsed"
                                        Background="#FF2E93"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        Margin="0,0,0,6"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="BrdSidebarUpdateBadge_MouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🚀 " FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtSidebarUpdateBadgeText" Text="Yeni Güncelleme Mevcut!" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button Content="🌐 GitHub İstemci Sayfasını Aç"
                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                        Padding="8,5"
                                        FontSize="11"
                                        Click="BtnOpenGitHubRepo_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== RIGHT MAIN AREA ==================== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- Custom Top Bar -->
                        <RowDefinition x:Name="RowTopBar" Height="64" />
                        <!-- Announcement / Status Ribbon -->
                        <RowDefinition x:Name="RowAnnouncementRibbon" Height="Auto" />
                        <!-- Main Animated Content Viewport -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Collapsible Live Log Strip -->
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>

                    <!-- 1. TOP WINDOW BAR -->
                    <Border x:Name="BrdTopWindowBar"
                            Grid.Row="0"
                            Background="#13091F"
                            BorderBrush="#2F163E"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            Padding="20,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Store & Library Header Tools (Search, Quick Filters, Telemetry Pill, Bug Report) -->
                            <Grid x:Name="PnlTopStoreNavTools" Grid.Column="0" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Search Box -->
                                <Grid VerticalAlignment="Center">
                                    <TextBox x:Name="TxtSearchApps"
                                             Style="{StaticResource PinkTextBoxStyle}"
                                             TextChanged="TxtSearchApps_TextChanged"
                                             ToolTip="Uygulama adı, kategori veya özellik ara" />
                                    <TextBlock x:Name="TxtSearchPlaceholder"
                                               Text="🔍 Uygulama, sürüm veya araç ara..."
                                               Foreground="#896280"
                                               FontSize="12.5"
                                               Margin="13,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                </Grid>

                                <!-- Quick Filter Pills -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button x:Name="BtnFilterAll" Content="Tümü" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,6" Margin="0,0,6,0" Click="BtnFilterAll_Click" />
                                    <Button x:Name="BtnFilterUpdates" Content="Güncelleme Bekleyenler" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,6" Margin="0,0,6,0" Click="BtnFilterUpdates_Click" />
                                    <Button Content="🔄 Kataloğu Senkronize Et" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,6" Click="BtnSyncCatalog_Click" />
                                </StackPanel>

                                <!-- Right Quick Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <!-- Active Speed Pill -->
                                    <Border Background="#210F30" BorderBrush="#522059" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " Foreground="#FF2E93" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtTopBandwidth" Text="Ağ: Hazır" Foreground="#FFB8DC" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Report Bug Pill -->
                                    <Button Content="🚨 Sorun Bildir"
                                            Style="{StaticResource PinkPrimaryButtonStyle}"
                                            Padding="13,6"
                                            FontSize="12"
                                            Click="BtnQuickReportIssue_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- Compact Header for Dev Studio and Other Sub-views -->
                            <StackPanel x:Name="PnlTopCompactHeader" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="TxtCompactHeaderTitle" Text="AlpTogether" Foreground="#FF85C0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Window Chrome Buttons (Always Visible) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="—" Width="34" Height="30" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="0" Margin="0,0,5,0" Click="BtnMinimize_Click" ToolTip="Küçült" />
                                <Button Content="▢" Width="34" Height="30" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="0" Margin="0,0,5,0" Click="BtnMaximize_Click" ToolTip="Tam Ekran / Boyutlandır" />
                                <Button Content="✕" Width="34" Height="30" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="0" Click="BtnClose_Click" ToolTip="Kapat" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. ANNOUNCEMENT & ECOSYSTEM STATUS RIBBON -->
                    <StackPanel Grid.Row="1">
                        <!-- 2.1 CLIENT SELF-UPDATE BANNER -->
                        <Border x:Name="PnlClientUpdateBanner"
                                Background="#2A0B2C"
                                BorderBrush="#FF2E93"
                                BorderThickness="0,0,0,1.5"
                                Padding="22,8"
                                Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Background="#FF2E93" CornerRadius="5" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="YENİ SÜRÜM MEVCUT" Foreground="#FFFFFF" FontSize="10" FontWeight="ExtraBold" />
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnBannerUpdateNow"
                                            Content="🚀 Hemen Güncelle"
                                            Style="{StaticResource PinkPrimaryButtonStyle}"
                                            Padding="13,5"
                                            FontSize="11.5"
                                            FontWeight="Bold"
                                            Margin="0,0,8,0"
                                            Click="BtnClientUpdateOpenModal_Click" />
                                    <Button x:Name="BtnBannerViewNotes"
                                            Content="Yama Notları"
                                            Style="{StaticResource PinkSecondaryButtonStyle}"
                                            Padding="10,5"
                                            FontSize="11"
                                            Margin="0,0,8,0"
                                            Click="BtnBannerViewNotes_Click" />
                                    <Button Content="✕"
                                            Foreground="#FF85C0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Click="BtnDismissUpdateBanner_Click"
                                            ToolTip="Güncelleme bildirimini kapat" />
                                </StackPanel>
                                <TextBlock x:Name="TxtClientUpdateBannerText"
                                           Text="AlpTogether'ın yeni bir sürümü yayınlandı! Tek tıkla kendinizi güncelleyin."
                                           Foreground="#FFE0F1"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>

                        <!-- 2.2 ANNOUNCEMENT & ECOSYSTEM STATUS RIBBON -->
                        <Border x:Name="PnlAnnouncementRibbon"
                            Grid.Row="1"
                            Background="#1B0B28"
                            BorderBrush="#3D1A4C"
                            BorderThickness="0,0,0,1"
                            Padding="22,7"
                            Visibility="Visible">
                        <DockPanel>
                            <Border Background="#FF2E93" CornerRadius="5" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="CANLI DUYURU" Foreground="#FFFFFF" FontSize="10" FontWeight="ExtraBold" />
                            </Border>
                            <TextBlock x:Name="TxtGlobalAnnouncement"
                                       Text="AlpTogether v1.0 Yayında! Yeni geliştirdiğiniz her uygulama bulut kataloğuna düştüğü an tüm kullanıcılarda listelenir."
                                       Foreground="#F5D0E6"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <TextBlock x:Name="TxtInstalledSummary" Text="Kurulu: 0 / 6" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    </StackPanel>

                    <!-- 3. MAIN ANIMATED VIEWPORT -->
                    <Grid Grid.Row="2" x:Name="ViewportContainer" Margin="0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ViewportSlideTransform" X="0" Y="0" />
                        </Grid.RenderTransform>

                        <!-- ==================== VIEW 1: STORE & LIBRARY (STEAM / RIOT HYBRID) ==================== -->
                        <ScrollViewer x:Name="ViewStoreLibrary"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="22,18,22,22"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      TextOptions.TextFormattingMode="Display"
                                      RenderOptions.BitmapScalingMode="HighQuality">
                            <StackPanel>

                                <!-- ARABALAR 1 (CARS 2006) 1080P DUAL CINEMA VIDEO PLAYER -->
                                <controls:CarsVideoPlayerControl x:Name="CarsPlayer" Margin="0,0,0,18" />

                                <!-- SELECTED APP HERO SHOWCASE CARD -->
                                <Border Background="{StaticResource PinkHeroBackdropBrush}"
                                        BorderBrush="#7A2866"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        Padding="24,22"
                                        Margin="0,0,0,20">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#33FF2E93" BlurRadius="28" ShadowDepth="0" Opacity="0.45" />
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="340" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Selected App Large Emblem -->
                                        <Border Width="116" Height="116"
                                                CornerRadius="24"
                                                BorderBrush="#FF5CAA"
                                                BorderThickness="2"
                                                VerticalAlignment="Top"
                                                Background="#14081E"
                                                ClipToBounds="True">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF2E93" BlurRadius="22" ShadowDepth="0" Opacity="0.6" />
                                            </Border.Effect>
                                            <Image x:Name="ImgHeroAppIcon"
                                                   Source="pack://application:,,,/Assets/alptogether_logo_pink.png"
                                                   Stretch="Uniform"
                                                   Margin="4"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <!-- Center Info & Hybrid Controls -->
                                        <StackPanel Grid.Column="1" Margin="22,0,22,0">
                                            <WrapPanel Margin="0,0,0,6">
                                                <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                                    <TextBlock x:Name="TxtHeroStateBadge" Text="KURULU &amp; HAZIR" Foreground="#FFFFFF" FontSize="10.5" FontWeight="ExtraBold" />
                                                </Border>
                                                <Border Background="#2D123D" BorderBrush="#752968" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                                    <TextBlock x:Name="TxtHeroHybridBadge" Text="HİBRİT KURULUM DESTEKLİ" Foreground="#FF94C8" FontSize="10.5" FontWeight="Bold" />
                                                </Border>
                                                <Border Background="#211030" BorderBrush="#4C225C" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                                    <TextBlock x:Name="TxtHeroCategory" Text="Ağ &amp; Sistem" Foreground="#D7B2CA" FontSize="10.5" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="#1B2E28" BorderBrush="#00E676" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,0,4">
                                                    <TextBlock x:Name="TxtHeroHealthBadge" Text="Sağlıklı (%100 Doğrulandı)" Foreground="#69F0AE" FontSize="10.5" FontWeight="Bold" />
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock x:Name="TxtHeroAppName"
                                                       Text="AlpNet Pulse"
                                                       Foreground="#FFFFFF"
                                                       FontSize="28"
                                                       FontWeight="ExtraBold" />

                                            <TextBlock x:Name="TxtHeroSubtitle"
                                                       Text="Ağ Hızlandırma, Cloudflare WARP Tüneli &amp; Canlı Ses Çeviri Motoru"
                                                       Foreground="#FF85C0"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Margin="0,2,0,8" />

                                            <TextBlock x:Name="TxtHeroDescription"
                                                       Text="Uygulama açıklaması..."
                                                       Foreground="#DEC4D6"
                                                       FontSize="12.5"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"
                                                       Margin="0,0,0,12" />

                                            <!-- Hybrid Installer Mode Selector Strip -->
                                            <Border Background="#160922"
                                                    BorderBrush="#491E54"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,9"
                                                    Margin="0,0,0,12">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock Text="⚙ HİBRİT KURULUM &amp; GÜNCELLEME YÖNTEMİ:"
                                                                   Foreground="#FF85C0"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtHeroInstallPath"
                                                                   Text="Konum: C:\..."
                                                                   Foreground="#B08AA3"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Right"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="360" />
                                                    </DockPanel>

                                                    <WrapPanel>
                                                        <RadioButton x:Name="RbHybridAuto"
                                                                     Content="⚡ Birleşik Hibrit (Otomatik Setup + Doğrudan)"
                                                                     Foreground="#FFEAF5"
                                                                     FontSize="11.5"
                                                                     FontWeight="SemiBold"
                                                                     Margin="0,0,16,0"
                                                                     IsChecked="True"
                                                                     Checked="HybridModeRadio_Checked" />
                                                        <RadioButton x:Name="RbStandaloneInstaller"
                                                                     Content="🪟 Ayrı Kurulum Arayüzü (Kendi Setup Penceresi)"
                                                                     Foreground="#FFEAF5"
                                                                     FontSize="11.5"
                                                                     FontWeight="SemiBold"
                                                                     Margin="0,0,16,0"
                                                                     Checked="HybridModeRadio_Checked" />
                                                        <RadioButton x:Name="RbDirectFiles"
                                                                     Content="📦 Doğrudan Dosya Senkronizasyonu (Portable)"
                                                                     Foreground="#FFEAF5"
                                                                     FontSize="11.5"
                                                                     FontWeight="SemiBold"
                                                                     Checked="HybridModeRadio_Checked" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Secondary Management Toolbar (Repair, Move Path, Open Folder, Shortcut, Report Issue, AutoStart) -->
                                            <WrapPanel>
                                                <Button Content="🔧 Onar &amp; Bütünlük Doğrula"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,0,8,6"
                                                        Click="BtnHeroRepair_Click" />
                                                <Button Content="📁 Dosya Yolu Değiştir / Taşı"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,0,8,6"
                                                        Click="BtnHeroChangePath_Click" />
                                                <Button Content="📂 Dosya Konumunu Aç"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,0,8,6"
                                                        Click="BtnHeroOpenFolder_Click" />
                                                <Button Content="🖥 Masaüstü Kısayolu"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,0,8,6"
                                                        Click="BtnHeroCreateShortcut_Click" />
                                                <Button Content="🚨 Bu Uygulamada Hata Bildir"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,0,8,6"
                                                        Click="BtnHeroReportBug_Click" />
                                                <CheckBox x:Name="ChkAppAutoStart"
                                                          Content="🚀 Windows Başlangıcında Çalıştır"
                                                          Foreground="#FFE5F3"
                                                          FontSize="11.5"
                                                          FontWeight="SemiBold"
                                                          VerticalAlignment="Center"
                                                          Margin="4,0,0,6"
                                                          Click="ChkAppAutoStart_Click" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Right Action & Version Panel -->
                                        <Border Grid.Column="2"
                                                Background="#150920"
                                                BorderBrush="#52215B"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="18,16"
                                                VerticalAlignment="Stretch">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="SÜRÜM &amp; DURUM BİLGİSİ"
                                                           Foreground="#9E6E92"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,6" />

                                                <TextBlock x:Name="TxtHeroVersionCompare"
                                                           Text="Kurulu: v2.4.0  •  Güncel: v2.4.0"
                                                           Foreground="#FFFFFF"
                                                           FontSize="14.5"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,4" />

                                                <TextBlock x:Name="TxtHeroSizeAndDate"
                                                           Text="Boyut: 81.4 MB  •  Yayın: 16 Ekim 2026"
                                                           Foreground="#C79BB9"
                                                           FontSize="11.5"
                                                           Margin="0,0,0,14" />

                                                <!-- Giant Primary Action Button -->
                                                <Button x:Name="BtnHeroPrimaryAction"
                                                        Content="BAŞLAT"
                                                        Style="{StaticResource PinkPrimaryButtonStyle}"
                                                        FontSize="16"
                                                        Padding="20,14"
                                                        Click="BtnHeroPrimaryAction_Click" />

                                                <!-- Force Re-Update / Hybrid Setup Trigger Button -->
                                                <Button x:Name="BtnHeroRunInstallerExplicit"
                                                        Content="⚡ Kendi Kurulum Aracını (Setup) Çalıştır / Güncelle"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,8,0,0"
                                                        Padding="10,7"
                                                        FontSize="11.5"
                                                        Click="BtnHeroForceUpdate_Click" />

                                                <!-- Live Progress Bar inside Hero Card -->
                                                <StackPanel Margin="0,14,0,0">
                                                    <DockPanel Margin="0,0,0,5">
                                                        <TextBlock x:Name="TxtHeroProgressStatus"
                                                                   Text="Hazır"
                                                                   Foreground="#FF94C8"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="TxtHeroSpeed"
                                                                   Text=""
                                                                   Foreground="#00E676"
                                                                   FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <ProgressBar x:Name="PbHeroProgress"
                                                                 Height="8"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="100"
                                                                 Background="#261236"
                                                                 Foreground="#FF2E93"
                                                                 BorderThickness="0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ALL ECOSYSTEM APPS GRID HEADER -->
                                <DockPanel Margin="4,0,4,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TÜM ALP EKOSİSTEMİ UYGULAMALARI"
                                                   Foreground="#FFFFFF"
                                                   FontSize="16"
                                                   FontWeight="ExtraBold"
                                                   VerticalAlignment="Center" />
                                        <Border Background="#2D143B" CornerRadius="6" Padding="8,3" Margin="12,0,0,0">
                                            <TextBlock Text="Yayınlanan yeni uygulamalar otomatik olarak buraya düşer"
                                                       Foreground="#FF85C0"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- APPLICATION CARDS ITEMSCONTROL -->
                                <ItemsControl x:Name="IcAppCards"
                                              UseLayoutRounding="True"
                                              SnapsToDevicePixels="True"
                                              TextOptions.TextFormattingMode="Display"
                                              RenderOptions.BitmapScalingMode="HighQuality">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PinkCardGlassBrush}"
                                                    BorderBrush="#451E54"
                                                    BorderThickness="1.2"
                                                    CornerRadius="14"
                                                    Padding="18,16"
                                                    Margin="0,0,14,14"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="AppCard_MouseLeftButtonUp">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Card Header -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="68" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="64" Height="64" CornerRadius="14" BorderBrush="#FF5CAA" BorderThickness="1.2" ClipToBounds="True">
                                                            <Image Source="{Binding IconPackUri}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="15.5" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Category}" Foreground="#FF85C0" FontSize="11" FontWeight="SemiBold" />
                                                        </StackPanel>

                                                        <Border Grid.Column="2" VerticalAlignment="Top" Background="#2E133D" BorderBrush="#FF2E93" BorderThickness="1" CornerRadius="6" Padding="7,3">
                                                            <TextBlock Text="{Binding StateBadgeText}" Foreground="#FFD4EB" FontSize="9.5" FontWeight="Bold" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Version & Hybrid Pill -->
                                                    <WrapPanel Grid.Row="1" Margin="0,10,0,6">
                                                        <Border Background="#1B0C29" BorderBrush="#482058" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,6,4">
                                                            <TextBlock Text="{Binding VersionDisplay}" Foreground="#E8BBD8" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="#241033" CornerRadius="5" Padding="6,2" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding HybridBadgeText}" Foreground="#FF66B2" FontSize="10" FontWeight="Bold" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- Description -->
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding Description}"
                                                               Foreground="#C6A6BC"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="54"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,12" />

                                                    <!-- Progress Bar inside Card -->
                                                    <ProgressBar Grid.Row="3"
                                                                 Height="5"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding ProgressPercent}"
                                                                 Background="#1E0E2C"
                                                                 Foreground="#FF2E93"
                                                                 BorderThickness="0"
                                                                 Margin="0,0,0,10" />

                                                    <!-- Card Footer Actions -->
                                                    <Grid Grid.Row="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button Content="{Binding PrimaryButtonText}"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource PinkPrimaryButtonStyle}"
                                                                Padding="12,8"
                                                                FontSize="12"
                                                                Click="BtnCardPrimary_Click" />

                                                        <Button Grid.Column="1"
                                                                Content="🔧 Onar"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource PinkSecondaryButtonStyle}"
                                                                Padding="10,8"
                                                                Margin="6,0,0,0"
                                                                ToolTip="Dosya bütünlüğünü doğrula ve onar"
                                                                Click="BtnCardRepair_Click" />

                                                        <Button Grid.Column="2"
                                                                Content="📁"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource PinkSecondaryButtonStyle}"
                                                                Padding="10,8"
                                                                Margin="6,0,0,0"
                                                                ToolTip="Kurulum dosya yolunu değiştir veya taşı"
                                                                Click="BtnCardChangePath_Click" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- SELECTED APP PATCH NOTES & COMPANION FILES INSPECTOR -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selected App Changelog -->
                                    <Border Grid.Column="0"
                                            Background="#150B21"
                                            BorderBrush="#3F1C4E"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="18,16"
                                            Margin="0,0,14,0">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtSelectedAppChangelogTitle"
                                                       Text="✦ Seçili Uygulama Son Yenilikleri (Yama Notları)"
                                                       Foreground="#FF85C0"
                                                       FontSize="14"
                                                       FontWeight="ExtraBold"
                                                       Margin="0,0,0,10" />
                                            <ItemsControl x:Name="IcSelectedAppPatchNotes">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1D0F2D" BorderBrush="#3C1B4B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                                            <StackPanel>
                                                                <DockPanel Margin="0,0,0,4">
                                                                    <Border Background="#FF2E93" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ReleaseDate}" Foreground="#B287A6" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </DockPanel>
                                                                <ItemsControl ItemsSource="{Binding Changes}" Margin="4,4,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                                <TextBlock Text="• " Foreground="#FF5CAA" FontWeight="Bold" />
                                                                                <TextBlock Text="{Binding}" Foreground="#DEC2D5" FontSize="12" TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Selected App File Integrity & Companion Inspector -->
                                    <Border Grid.Column="1"
                                            Background="#150B21"
                                            BorderBrush="#3F1C4E"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="18,16">
                                        <StackPanel>
                                            <TextBlock Text="🛡 Hibrit Paket &amp; Dosya Bütünlüğü"
                                                       Foreground="#FF85C0"
                                                       FontSize="14"
                                                       FontWeight="ExtraBold"
                                                       Margin="0,0,0,10" />
                                            <TextBlock x:Name="TxtInspectorExeInfo"
                                                       Text="Ana Çalıştırılabilir Dosya: AlpNet.Pulse.exe"
                                                       Foreground="#FFF0F7"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,6" />
                                            <TextBlock x:Name="TxtInspectorInstallerInfo"
                                                       Text="Hibrit Setup Aracı: AlpNet.Setup.exe (/auto)"
                                                       Foreground="#D4A6C5"
                                                       FontSize="12"
                                                       Margin="0,0,0,10" />
                                            <TextBlock Text="Denetlenen Bileşenler:"
                                                       Foreground="#9E6E92"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,6" />
                                            <ItemsControl x:Name="IcSelectedAppCompanions">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1E102E" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                                            <DockPanel>
                                                                <TextBlock Text="✔ " Foreground="#00E676" FontWeight="Bold" />
                                                                <TextBlock Text="{Binding FileName}" Foreground="#FFEAF5" FontSize="12" FontWeight="SemiBold" />
                                                                <TextBlock Text="Hibrit Senkronize" Foreground="#FF85C0" FontSize="11" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ==================== VIEW 2: HYBRID DOWNLOADS & INSTALLER CENTER ==================== -->
                        <ScrollViewer x:Name="ViewDownloads" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
                            <StackPanel>
                                <TextBlock Text="⬇ İndirme Merkezi"
                                           Foreground="#FFFFFF"
                                           FontSize="22"
                                           FontWeight="ExtraBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Kendi kurulum arayüzü (Installer / Setup.exe) olan uygulamalar ile doğrudan taşınabilir paketleri tek merkezden yönetin."
                                           Foreground="#CCA6C0"
                                           FontSize="13"
                                           Margin="0,0,0,18" />

                                <!-- Live Animated Bandwidth Graph Card -->
                                <Border Background="{StaticResource PinkHeroBackdropBrush}"
                                        BorderBrush="#7A2866"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        Padding="22,18"
                                        Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ANLIK AKTARIM &amp; SENKRONİZASYON HIZI" Foreground="#FF85C0" FontSize="11" FontWeight="Bold" />
                                            <TextBlock x:Name="TxtDownloadCenterSpeed" Text="0.0 MB/sn" Foreground="#FFFFFF" FontSize="32" FontWeight="ExtraBold" Margin="0,4,0,4" />
                                            <TextBlock x:Name="TxtDownloadCenterActiveTask" Text="Aktif indirme bekleniyor..." Foreground="#D9B3CC" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14" />
                                            <Button Content="⚡ Tüm Kurulu Uygulamaları Güncelle &amp; Doğrula"
                                                    Style="{StaticResource PinkPrimaryButtonStyle}"
                                                    Padding="14,10"
                                                    Click="BtnUpdateAllApps_Click" />
                                        </StackPanel>

                                        <!-- Live Speed Chart Canvas -->
                                        <Border Grid.Column="1" Background="#12071B" BorderBrush="#3E1B4B" BorderThickness="1" CornerRadius="12" Height="150" Margin="20,0,0,0" Padding="10" ClipToBounds="True">
                                            <Grid>
                                                <Canvas x:Name="CanvasSpeedGraph" SizeChanged="CanvasSpeedGraph_SizeChanged">
                                                    <Polyline x:Name="PolylineSpeedStroke" Stroke="#FF2E93" StrokeThickness="3" />
                                                </Canvas>
                                                <TextBlock Text="Canlı Ağ &amp; Disk Yazma Akışı (60 FPS)" Foreground="#6E4664" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Hybrid Architecture Explanation Cards -->
                                <UniformGrid Columns="3" Margin="0,0,0,18">
                                    <Border Background="#180C25" BorderBrush="#FF2E93" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="1. Birleşik Hibrit Mod (Önerilen)" Foreground="#FF5CAA" FontSize="14" FontWeight="ExtraBold" Margin="0,0,0,6" />
                                            <TextBlock Text="Uygulamanın kendi Setup.exe dosyası varsa '/auto' parametresiyle sessizce kurar veya doğrudan .exe + ek bileşenleri (Örn: translator.exe) indirip SHA-256 ile doğrular."
                                                       Foreground="#D6B8CC" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#180C25" BorderBrush="#522261" BorderThickness="1" CornerRadius="12" Padding="16" Margin="5,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="2. Ayrı Installer Arayüzü Modu" Foreground="#FF85C0" FontSize="14" FontWeight="ExtraBold" Margin="0,0,0,6" />
                                            <TextBlock Text="Kendi özel kurulum penceresi olan uygulamaların (Örn: AlpNet.Setup.exe veya MSI) kurulum arayüzünü ayrı pencerede açar ve kurulum bitince AlpTogether'a bağlar."
                                                       Foreground="#D6B8CC" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#180C25" BorderBrush="#522261" BorderThickness="1" CornerRadius="12" Padding="16" Margin="10,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="3. Doğrudan Dosya Senkronizasyonu" Foreground="#FFB2D8" FontSize="14" FontWeight="ExtraBold" Margin="0,0,0,6" />
                                            <TextBlock Text="Harici kurulum sihirbazlarını tamamen atlayarak doğrudan yürütülebilir paketleri seçtiğiniz klasöre indirir ve günceller."
                                                       Foreground="#D6B8CC" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Per-App Hybrid Queue List -->
                                <ItemsControl x:Name="IcDownloadQueueList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#160B22" BorderBrush="#3D1C4C" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="9" ClipToBounds="True">
                                                        <Image Source="{Binding IconPackUri}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding VersionDisplay}" Foreground="#FF85C0" FontSize="11" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,16,0">
                                                        <DockPanel Margin="0,0,0,4">
