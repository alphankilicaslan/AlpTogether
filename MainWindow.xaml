                                                        </DockPanel>
                                                        <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Background="#261238" Foreground="#FF2E93" BorderThickness="0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="{Binding PrimaryButtonText}" Tag="{Binding}" Style="{StaticResource PinkPrimaryButtonStyle}" Padding="14,7" FontSize="11.5" Click="BtnCardPrimary_Click" />
                                                        <Button Content="🔧 Onar" Tag="{Binding}" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,7" Margin="8,0,0,0" Click="BtnCardRepair_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
