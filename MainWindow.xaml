<Window x:Class="AlpTogether.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AlpTogether — Birleşik Uygulama İstemcisi"
        Width="1380" Height="860"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/Assets/app_icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="AmbientOrb1Transform"
                                     Storyboard.TargetProperty="X"
                                     From="-40" To="90" Duration="0:0:9" />
                    <DoubleAnimation Storyboard.TargetName="AmbientOrb1Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="-20" To="60" Duration="0:0:7" />
                    <DoubleAnimation Storyboard.TargetName="AmbientOrb2Transform"
                                     Storyboard.TargetProperty="X"
                                     From="40" To="-80" Duration="0:0:11" />
                    <DoubleAnimation Storyboard.TargetName="AmbientOrb2Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="30" To="-50" Duration="0:0:8" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Outer Window Frame -->
    <Border x:Name="OuterWindowBorder"
            Background="{StaticResource BgDeepBrush}"
            BorderBrush="#4A1D56"
            BorderThickness="1.5"
            CornerRadius="16"
            ClipToBounds="True">

        <Grid>
            <!-- Animated Pink / Rose Ambient Glow Orbs -->
            <Canvas IsHitTestVisible="False" Opacity="0.42">
                <Ellipse Width="520" Height="520" Canvas.Left="-120" Canvas.Top="-140">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="AmbientOrb1Transform" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55FF2E93" Offset="0" />
                            <GradientStop Color="#22D81B60" Offset="0.5" />
                            <GradientStop Color="#0009050E" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="620" Height="620" Canvas.Right="-160" Canvas.Bottom="-180">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="AmbientOrb2Transform" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#44FF5CAA" Offset="0" />
                            <GradientStop Color="#189C27B0" Offset="0.55" />
                            <GradientStop Color="#0009050E" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left Navigation & Quick App Rail -->
                    <ColumnDefinition Width="265" />
                    <!-- Main Content Area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT SIDEBAR ==================== -->
                <Border Grid.Column="0"
                        Background="#11081B"
                        BorderBrush="#331742"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Brand Header with Pink Logo -->
                        <Border Grid.Row="0" Padding="18,18,18,14" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" BorderBrush="#FF5CAA" BorderThickness="1.5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF2E93" BlurRadius="18" ShadowDepth="0" Opacity="0.65" />
                                    </Border.Effect>
                                    <Image Source="pack://application:,,,/Assets/alptogether_logo_pink.png"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Alp" Foreground="#FFFFFF" FontSize="20" FontWeight="ExtraBold" />
                                        <TextBlock Text="Together" Foreground="#FF3D9A" FontSize="20" FontWeight="ExtraBold" />
                                    </StackPanel>
                                    <TextBlock Text="UNIFIED ECOSYSTEM CLIENT"
                                               Foreground="#B987AD"
                                               FontSize="9.5"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Navigation Menu -->
                        <StackPanel Grid.Row="1" Margin="12,4,12,8">
                            <TextBlock Text="ANA MENÜ" Foreground="#8E6384" FontSize="10.5" FontWeight="Bold" Margin="10,4,0,6" />

                            <Button x:Name="BtnNavStore" Style="{StaticResource NavTabButtonStyle}" Click="BtnNavStore_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❖" Foreground="#FF2E93" FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Kütüphane &amp; Keşfet" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavDownloads" Style="{StaticResource NavTabButtonStyle}" Click="BtnNavDownloads_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬇" Foreground="#FF5CAA" FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Hibrit Kurulum &amp; İndirme" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavChangelog" Style="{StaticResource NavTabButtonStyle}" Click="BtnNavChangelog_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✦" Foreground="#FF85C0" FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Son Yenilikler (Yama Notu)" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavRepair" Style="{StaticResource NavTabButtonStyle}" Click="BtnNavRepair_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠" Foreground="#FF4081" FontSize="14" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Onarım &amp; Dosya Yolu" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavCustomLogs" Style="{StaticResource NavTabButtonStyle}" Click="BtnNavCustomLogs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▤" Foreground="#FF66B2" FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Özel Boşluk &amp; Canlı Log" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavHelp" Style="{StaticResource NavTabButtonStyle}" Click="BtnNavHelp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💬" Foreground="#FF2E93" FontSize="14" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Yardım &amp; Sorun Bildir" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavPublisher" Style="{StaticResource NavTabButtonStyle}" Click="BtnNavPublisher_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" Foreground="#FF80AB" FontSize="14" Width="24" VerticalAlignment="Center" />
                                    <TextBlock Text="Uygulama Yayınla &amp; Ayarlar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Riot/Steam Style Quick App Switcher List -->
                        <Grid Grid.Row="2" Margin="12,4,12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="10,4,6,8">
                                <TextBlock Text="HIZLI UYGULAMA GEÇİŞİ" Foreground="#8E6384" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtSidebarAppCount" Text="6" Foreground="#FF5CAA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            </DockPanel>

                            <ListBox x:Name="LstQuickApps"
                                     Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="LstQuickApps_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,3" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="#180D26"
                                                            BorderBrush="#2E1640"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="9,8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#251339" />
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#7A2866" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#31133E" />
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF2E93" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="7" ClipToBounds="True" BorderBrush="#55FF5CAA" BorderThickness="1">
                                                <Image Source="{Binding IconPackUri}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#FFF2F9" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StateBadgeText}" Foreground="#C48FB3" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" Background="#2A1238" CornerRadius="6" Padding="6,2" BorderBrush="#592252" BorderThickness="1">
                                                <TextBlock Text="{Binding LatestVersion, StringFormat=v{0}}" Foreground="#FF85C0" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Sidebar Footer: Telemetry & GitHub Status -->
                        <Border Grid.Row="3"
                                Margin="12,0,12,12"
                                Padding="12,10"
                                CornerRadius="12"
                                Background="#190C26"
                                BorderBrush="#441E4E"
                                BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#00E676" Margin="0,0,7,0" />
                                        <TextBlock Text="Anlık Telemetri &amp; Bulut Aktif" Foreground="#FFD4EB" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="TxtDeviceIdFooter"
                                           Text="Cihaz ID: ALP-..."
                                           Foreground="#9C7391"
                                           FontSize="10"
                                           Margin="0,4,0,6" />
                                <Button Content="🌐 GitHub İstemci Sayfasını Aç"
                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                        Padding="8,5"
                                        FontSize="11"
                                        Click="BtnOpenGitHubRepo_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== RIGHT MAIN AREA ==================== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- Custom Top Bar -->
                        <RowDefinition Height="64" />
                        <!-- Announcement / Status Ribbon -->
                        <RowDefinition Height="Auto" />
                        <!-- Main Animated Content Viewport -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Collapsible Live Log Strip -->
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>

                    <!-- 1. TOP WINDOW BAR -->
                    <Border Grid.Row="0"
                            Background="#13091F"
                            BorderBrush="#2F163E"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            Padding="20,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Box -->
                            <Grid VerticalAlignment="Center">
                                <TextBox x:Name="TxtSearchApps"
                                         Style="{StaticResource PinkTextBoxStyle}"
                                         TextChanged="TxtSearchApps_TextChanged"
                                         ToolTip="Uygulama adı, kategori veya özellik ara" />
                                <TextBlock x:Name="TxtSearchPlaceholder"
                                           Text="🔍 Uygulama, sürüm veya araç ara..."
                                           Foreground="#896280"
                                           FontSize="12.5"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>

                            <!-- Quick Filter Pills -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="BtnFilterAll" Content="Tümü" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,6" Margin="0,0,6,0" Click="BtnFilterAll_Click" />
                                <Button x:Name="BtnFilterInstalled" Content="Kurulu Olanlar" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,6" Margin="0,0,6,0" Click="BtnFilterInstalled_Click" />
                                <Button x:Name="BtnFilterUpdates" Content="Güncelleme Bekleyenler" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,6" Margin="0,0,6,0" Click="BtnFilterUpdates_Click" />
                                <Button Content="🔄 Kataloğu Senkronize Et" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="12,6" Click="BtnSyncCatalog_Click" />
                            </StackPanel>

                            <!-- Right Quick Actions & Window Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Active Speed Pill -->
                                <Border Background="#210F30" BorderBrush="#522059" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " Foreground="#FF2E93" FontSize="11.5" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtTopBandwidth" Text="Ağ: Hazır" Foreground="#FFB8DC" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Quick Report Bug Pill -->
                                <Button Content="🚨 Sorun Bildir"
                                        Style="{StaticResource PinkPrimaryButtonStyle}"
                                        Padding="13,6"
                                        FontSize="12"
                                        Margin="0,0,14,0"
                                        Click="BtnQuickReportIssue_Click" />

                                <!-- Window Chrome Buttons -->
                                <Button Content="—" Width="34" Height="30" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="0" Margin="0,0,5,0" Click="BtnMinimize_Click" ToolTip="Küçült" />
                                <Button Content="▢" Width="34" Height="30" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="0" Margin="0,0,5,0" Click="BtnMaximize_Click" ToolTip="Tam Ekran / Boyutlandır" />
                                <Button Content="✕" Width="34" Height="30" Style="{StaticResource PinkSecondaryButtonStyle}" Padding="0" Click="BtnClose_Click" ToolTip="Kapat" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. ANNOUNCEMENT & ECOSYSTEM STATUS RIBBON -->
                    <Border Grid.Row="1"
                            Background="#1B0B28"
                            BorderBrush="#3D1A4C"
                            BorderThickness="0,0,0,1"
                            Padding="22,7">
                        <DockPanel>
                            <Border Background="#FF2E93" CornerRadius="5" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="CANLI DUYURU" Foreground="#FFFFFF" FontSize="10" FontWeight="ExtraBold" />
                            </Border>
                            <TextBlock x:Name="TxtGlobalAnnouncement"
                                       Text="AlpTogether v1.0 Yayında! Yeni geliştirdiğiniz her uygulama bulut kataloğuna düştüğü an tüm kullanıcılarda listelenir."
                                       Foreground="#F5D0E6"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <TextBlock x:Name="TxtInstalledSummary" Text="Kurulu: 0 / 6" Foreground="#FF85C0" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 3. MAIN ANIMATED VIEWPORT -->
                    <Grid Grid.Row="2" x:Name="ViewportContainer" Margin="0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ViewportSlideTransform" X="0" Y="0" />
                        </Grid.RenderTransform>

                        <!-- ==================== VIEW 1: STORE & LIBRARY (STEAM / RIOT HYBRID) ==================== -->
                        <ScrollViewer x:Name="ViewStoreLibrary" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
                            <StackPanel>

                                <!-- SELECTED APP HERO SHOWCASE CARD -->
                                <Border Background="{StaticResource PinkHeroBackdropBrush}"
                                        BorderBrush="#7A2866"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        Padding="24,22"
                                        Margin="0,0,0,20">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#33FF2E93" BlurRadius="28" ShadowDepth="0" Opacity="0.45" />
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="340" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Selected App Large Emblem -->
                                        <Border Width="116" Height="116"
                                                CornerRadius="24"
                                                BorderBrush="#FF5CAA"
                                                BorderThickness="2"
                                                VerticalAlignment="Top"
                                                Background="#14081E">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF2E93" BlurRadius="22" ShadowDepth="0" Opacity="0.6" />
                                            </Border.Effect>
                                            <Image x:Name="ImgHeroAppIcon"
                                                   Source="pack://application:,,,/Assets/alptogether_logo_pink.png"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <!-- Center Info & Hybrid Controls -->
                                        <StackPanel Grid.Column="1" Margin="22,0,22,0">
                                            <WrapPanel Margin="0,0,0,6">
                                                <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                                    <TextBlock x:Name="TxtHeroStateBadge" Text="KURULU &amp; HAZIR" Foreground="#FFFFFF" FontSize="10.5" FontWeight="ExtraBold" />
                                                </Border>
                                                <Border Background="#2D123D" BorderBrush="#752968" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                                    <TextBlock x:Name="TxtHeroHybridBadge" Text="HİBRİT KURULUM DESTEKLİ" Foreground="#FF94C8" FontSize="10.5" FontWeight="Bold" />
                                                </Border>
                                                <Border Background="#211030" BorderBrush="#4C225C" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                                    <TextBlock x:Name="TxtHeroCategory" Text="Ağ &amp; Sistem" Foreground="#D7B2CA" FontSize="10.5" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="#1B2E28" BorderBrush="#00E676" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,0,4">
                                                    <TextBlock x:Name="TxtHeroHealthBadge" Text="Sağlıklı (%100 Doğrulandı)" Foreground="#69F0AE" FontSize="10.5" FontWeight="Bold" />
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock x:Name="TxtHeroAppName"
                                                       Text="AlpNet Pulse"
                                                       Foreground="#FFFFFF"
                                                       FontSize="28"
                                                       FontWeight="ExtraBold" />

                                            <TextBlock x:Name="TxtHeroSubtitle"
                                                       Text="Ağ Hızlandırma, Cloudflare WARP Tüneli &amp; Canlı Ses Çeviri Motoru"
                                                       Foreground="#FF85C0"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Margin="0,2,0,8" />

                                            <TextBlock x:Name="TxtHeroDescription"
                                                       Text="Uygulama açıklaması..."
                                                       Foreground="#DEC4D6"
                                                       FontSize="12.5"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"
                                                       Margin="0,0,0,12" />

                                            <!-- Hybrid Installer Mode Selector Strip -->
                                            <Border Background="#160922"
                                                    BorderBrush="#491E54"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,9"
                                                    Margin="0,0,0,12">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock Text="⚙ HİBRİT KURULUM &amp; GÜNCELLEME YÖNTEMİ:"
                                                                   Foreground="#FF85C0"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtHeroInstallPath"
                                                                   Text="Konum: C:\..."
                                                                   Foreground="#B08AA3"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Right"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="360" />
                                                    </DockPanel>

                                                    <WrapPanel>
                                                        <RadioButton x:Name="RbHybridAuto"
                                                                     Content="⚡ Birleşik Hibrit (Otomatik Setup + Doğrudan)"
                                                                     Foreground="#FFEAF5"
                                                                     FontSize="11.5"
                                                                     FontWeight="SemiBold"
                                                                     Margin="0,0,16,0"
                                                                     IsChecked="True"
                                                                     Checked="HybridModeRadio_Checked" />
                                                        <RadioButton x:Name="RbStandaloneInstaller"
                                                                     Content="🪟 Ayrı Kurulum Arayüzü (Kendi Setup Penceresi)"
                                                                     Foreground="#FFEAF5"
                                                                     FontSize="11.5"
                                                                     FontWeight="SemiBold"
                                                                     Margin="0,0,16,0"
                                                                     Checked="HybridModeRadio_Checked" />
                                                        <RadioButton x:Name="RbDirectFiles"
                                                                     Content="📦 Doğrudan Dosya Senkronizasyonu (Portable)"
                                                                     Foreground="#FFEAF5"
                                                                     FontSize="11.5"
                                                                     FontWeight="SemiBold"
                                                                     Checked="HybridModeRadio_Checked" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Secondary Management Toolbar (Repair, Move Path, Open Folder, Shortcut, Report Issue) -->
                                            <WrapPanel>
                                                <Button Content="🔧 Onar &amp; Bütünlük Doğrula"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,0,8,6"
                                                        Click="BtnHeroRepair_Click" />
                                                <Button Content="📁 Dosya Yolu Değiştir / Taşı"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,0,8,6"
                                                        Click="BtnHeroChangePath_Click" />
                                                <Button Content="📂 Dosya Konumunu Aç"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,0,8,6"
                                                        Click="BtnHeroOpenFolder_Click" />
                                                <Button Content="🖥 Masaüstü Kısayolu"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
                                                        Margin="0,0,8,6"
                                                        Click="BtnHeroCreateShortcut_Click" />
                                                <Button Content="🚨 Bu Uygulamada Hata Bildir"
                                                        Style="{StaticResource PinkSecondaryButtonStyle}"
