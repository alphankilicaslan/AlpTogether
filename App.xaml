<Application x:Class="AlpTogether.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Signature AlpTogether Pink / Rose / Cyber-Obsidian Palette -->
        <Color x:Key="BgDeepColor">#09050E</Color>
        <Color x:Key="BgSurfaceColor">#120A1D</Color>
        <Color x:Key="BgCardColor">#1A0F29</Color>
        <Color x:Key="BgCardHoverColor">#241438</Color>
        <Color x:Key="PinkPrimaryColor">#FF2E93</Color>
        <Color x:Key="PinkHotColor">#FF5CAA</Color>
        <Color x:Key="PinkSoftColor">#FF94C8</Color>
        <Color x:Key="PinkDeepColor">#C51162</Color>
        <Color x:Key="BorderPinkSubtleColor">#3D1E4D</Color>

        <SolidColorBrush x:Key="BgDeepBrush" Color="#09050E" />
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="#120A1D" />
        <SolidColorBrush x:Key="BgCardBrush" Color="#1A0F29" />
        <SolidColorBrush x:Key="BgCardHoverBrush" Color="#241438" />
        <SolidColorBrush x:Key="PinkPrimaryBrush" Color="#FF2E93" />
        <SolidColorBrush x:Key="PinkHotBrush" Color="#FF5CAA" />
        <SolidColorBrush x:Key="PinkSoftBrush" Color="#FFB2D8" />
        <SolidColorBrush x:Key="PinkMutedBrush" Color="#C988AC" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5FA" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C4A8BC" />
        <SolidColorBrush x:Key="BorderPinkBrush" Color="#3E1E4E" />
        <SolidColorBrush x:Key="BorderPinkBrightBrush" Color="#FF2E93" />

        <LinearGradientBrush x:Key="PinkNeonGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1E80" Offset="0.0" />
            <GradientStop Color="#FF4DA6" Offset="0.5" />
            <GradientStop Color="#D81B60" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PinkHeroBackdropBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#350E2B" Offset="0.0" />
            <GradientStop Color="#1B0B26" Offset="0.55" />
            <GradientStop Color="#11071A" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PinkCardGlassBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#231233" Offset="0.0" />
            <GradientStop Color="#160B22" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Primary Animated Pink Action Button -->
        <Style x:Key="PinkPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PinkNeonGradientBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#FF85C0"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect x:Name="GlowEffect" Color="#FF2E93" BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Glass Pink Button -->
        <Style x:Key="PinkSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#241334" />
            <Setter Property="Foreground" Value="#FFD6EC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#542766" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="#381B4E" />
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="#FF2E93" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="#4C2269" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8A8C0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#251336" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#5C286E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled Dark-Pink TextBox -->
        <Style x:Key="PinkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#140A20" />
            <Setter Property="Foreground" Value="#FFF5FA" />
            <Setter Property="CaretBrush" Value="#FF2E93" />
            <Setter Property="BorderBrush" Value="#452157" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#FF2E93" />
                                <Setter TargetName="TxtBorder" Property="Background" Value="#1B0D2B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Slim Pink ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Resources>
</Application>
