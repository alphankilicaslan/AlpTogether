<Window x:Class="AlpTogether.RemoteDesktopViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlpDestek • Canlı Destek &amp; Uzak Masaüstü"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0E0517"
        Foreground="#FFFFFF"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Control Bar -->
            <RowDefinition Height="52" />
            <!-- Remote Screen Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- TOP CONTROL BAR -->
        <Border Grid.Row="0" Background="#160822" BorderBrush="#3D144F" BorderThickness="0,0,0,1" Padding="14,0">
            <DockPanel LastChildFill="True">
                <!-- Right Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkControlEnabled"
                              Content="Fare &amp; Klavye Kontrolü"
                              Foreground="#00E5FF"
                              FontSize="11.5"
                              FontWeight="Bold"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />

                    <Button x:Name="BtnEndSession"
                            Content="🔴 Oturumu Sonlandır"
                            Background="#FF1744"
                            Foreground="#FFFFFF"
                            FontWeight="Bold"
                            FontSize="11.5"
                            Padding="14,7"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnEndSession_Click" />
                </StackPanel>

                <!-- Left Info & Status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FF2E93" CornerRadius="6" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="ALPDESKEK" Foreground="#FFFFFF" FontSize="10" FontWeight="ExtraBold" />
                    </Border>

                    <TextBlock x:Name="TxtTargetUserTitle"
                               Text="Hedef Kullanıcı: -"
                               Foreground="#FFFFFF"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <Border Background="#200E2C" BorderBrush="#55246D" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="TxtTargetHwid" Text="HWID: -" Foreground="#7E5676" FontSize="10.5" FontFamily="Consolas" />
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotSessionStatus" Width="9" Height="9" Fill="#FFB300" Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtSessionStatus" Text="Kullanıcıdan onay bekleniyor..." Foreground="#FFB300" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- REMOTE SCREEN AREA -->
        <Grid Grid.Row="1" Background="#0A0310">
            <!-- Waiting Consent Overlay -->
            <StackPanel x:Name="PnlWaitingConsent" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="#230E36" BorderBrush="#FF2E93" BorderThickness="2" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <TextBlock Text="📡" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Kullanıcıya Canlı Destek İsteği Gönderildi" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="Hedef kullanıcının ekranında izin onay penceresi açıldı. Onayladığı an canlı yayın başlayacaktır." Foreground="#BCA4B7" FontSize="12.5" Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Screen Viewbox -->
            <Viewbox x:Name="ViewboxScreen" Stretch="Uniform" Visibility="Collapsed">
                <Grid x:Name="GridCanvas"
                      Focusable="True"
                      MouseMove="GridCanvas_MouseMove"
                      MouseDown="GridCanvas_MouseDown"
                      MouseUp="GridCanvas_MouseUp"
                      MouseWheel="GridCanvas_MouseWheel"
                      PreviewKeyDown="GridCanvas_PreviewKeyDown"
                      PreviewKeyUp="GridCanvas_PreviewKeyUp">
                    <Image x:Name="ImgRemoteScreen" RenderOptions.BitmapScalingMode="LowQuality" />
                </Grid>
            </Viewbox>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#11061C" BorderBrush="#2A0F38" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TxtFpsCounter" DockPanel.Dock="Right" Text="Akış: Bekleniyor" Foreground="#A97E9C" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 İpucu: Tam ekran kontrolü için pencereyi büyütebilirsiniz. Bağlantı uçtan uca şifreli ve güvenlidir." Foreground="#7E5676" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
