<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>AlpTogether</AssemblyName>
    <RootNamespace>AlpTogether</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Authors>Alphan Kılıçaslan</Authors>
    <Product>AlpTogether Client</Product>
    <Description>Alp Ekosistemi Birleşik Uygulama İstemcisi, Hibrit Kurulum ve Onarım Merkezi</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AlpTogetherWebSetup\**" />
    <Page Remove="AlpTogetherWebSetup\**" />
    <ApplicationDefinition Remove="AlpTogetherWebSetup\**" />
    <EmbeddedResource Remove="AlpTogetherWebSetup\**" />
    <None Remove="AlpTogetherWebSetup\**" />
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\alptogether_logo_pink.png" />
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\AppIcons\*.png" />
    <Resource Include="Effects\*.ps" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AlpTogether.Tests" />
  </ItemGroup>

</Project>